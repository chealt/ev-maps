{
  "name": "@ev-maps/monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "EV Maps - Astro + Web Components + Cloudflare",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd packages/app dev",
    "build": "bun run --cwd packages/app build",
    "preview": "bun run --cwd packages/app preview",
    "lint": "bun run --cwd packages/dev-config lint",
    "format": "bun run --cwd packages/dev-config format",
    "format:check": "bun run --cwd packages/dev-config format:check"
  },
  "devDependencies": {
    "bun": "^1.0.0"
  },
  "packageManager": "bun@1.0.0",
  "engines": {
    "bun": ">=1.0.0"
  }
}
