{
  "name": "@ev-maps/worker",
  "version": "0.0.1",
  "private": true,
  "description": "EV Maps Cloudflare Worker: charger API, redirect to the country pages and charger import",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/app-build-stub.js && wrangler d1 migrations apply ev-maps --local --env local && wrangler d1 migrations apply ev-maps-admin --local --env local && wrangler dev --env local --port 8787 --test-scheduled",
    "build": "bun scripts/app-build-stub.js && wrangler deploy --dry-run --outdir dist --env=",
    "export": "node scripts/export-chargers.js",
    "test": "bun test",
    "lint": "oxlint -c ../dev-config/oxlint.json src scripts",
    "format": "oxfmt -c ../dev-config/.oxfmtrc.json --ignore-path ../../.gitignore .",
    "format:check": "oxfmt -c ../dev-config/.oxfmtrc.json --ignore-path ../../.gitignore --check ."
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.25",
    "@ev-maps/admin": "workspace:*",
    "@ev-maps/tiles": "workspace:*",
    "@rapideditor/country-coder": "^6.0.0",
    "better-auth": "^1.7.25",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@ev-maps/dev-config": "workspace:*",
    "kysely": "0.29.9",
    "wrangler": "4.164.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.0.0"
  }
}
