{
  "name": "@ev-maps/e2e",
  "version": "0.0.1",
  "private": true,
  "description": "EV Maps' E2E test fixtures: Playwright's test with accessibility and performance checks, and fake APIs for the app's dependencies",
  "type": "module",
  "exports": {
    "./test.js": "./src/test.js",
    "./web-vitals.js": "./src/web-vitals.js",
    "./auth-api.js": "./src/auth-api.js",
    "./chargers-api.js": "./src/chargers-api.js",
    "./chargers.json": "./src/chargers.json",
    "./fake-google-maps.js": "./src/fake-google-maps.js",
    "./favorites-api.js": "./src/favorites-api.js",
    "./google.js": "./src/google.js",
    "./page-data.js": "./src/page-data.js",
    "./settings-api.js": "./src/settings-api.js"
  },
  "scripts": {
    "lint": "oxlint -c ../dev-config/oxlint.json .",
    "format": "oxfmt -c ../dev-config/.oxfmtrc.json --ignore-path ../../.gitignore .",
    "format:check": "oxfmt -c ../dev-config/.oxfmtrc.json --ignore-path ../../.gitignore --check ."
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@ev-maps/tiles": "workspace:*",
    "@playwright/test": "^1.65.1"
  },
  "devDependencies": {
    "@ev-maps/dev-config": "workspace:*"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.0.0"
  }
}
