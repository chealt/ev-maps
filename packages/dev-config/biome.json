{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "plugins": [
    {
      "path": "./no-hardcoded-css-units.grit",
      "includes": ["**/src/components/**/*.css"]
    }
  ],
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/src/components/**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noHexColors": "error"
          }
        }
      }
    }
  ],
  "files": {
    "includes": ["**/*.css"]
  }
}
