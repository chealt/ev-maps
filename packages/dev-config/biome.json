{
  "$schema": "../../node_modules/@biomejs/biome/configuration_schema.json",
  "root": true,
  "plugins": [
    {
      "path": "@ev-maps/biome-plugin-css-units/no-disallowed-css-units",
      "resolutionKind": "config",
      "includes": ["**/src/components/**/*.css"]
    }
  ],
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["**/src/components/**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noHexColors": "error"
          }
        }
      }
    }
  ],
  "files": {
    "includes": ["**/*.css"]
  }
}
