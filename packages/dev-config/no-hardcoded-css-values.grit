language css;

// Component CSS must use CSS variables. Literal values are only allowed where
// a custom property is defined, e.g. `--marker-size: 2.25rem`.
$value where {
  $value <: or {
    CssColor(),
    CssRegularDimension() as $dimension where { $dimension <: r"(?i)[0-9.]+(?:px|rem)" }
  },
  not $value <: within CssGenericProperty(name = CssDashedIdentifier()),
  register_diagnostic(
    span = $value,
    message = "Hardcoded color or px/rem value. Use a CSS variable instead."
  )
}
