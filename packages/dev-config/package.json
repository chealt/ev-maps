{
  "name": "@ev-maps/dev-config",
  "version": "0.0.1",
  "private": true,
  "description": "Shared dev configs for linting, formatting, and building",
  "scripts": {
    "lint": "echo 'dev-config: No JavaScript files to lint (only JSON configs)'",
    "lint:js": "oxlint **/*.{js,ts,astro}",
    "lint:css": "biome lint packages/app/src/components/button/Button.css packages/app/src/components/map/Map.css packages/app/src/layouts/global.css",
    "format": "oxfmt **/*.{js,ts,astro}",
    "format:check": "oxfmt --check **/*.{js,ts,astro}"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "oxfmt": "^0.4.0",
    "oxlint": "^0.4.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.4"
}
