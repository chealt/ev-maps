{
  "name": "@ev-maps/app",
  "version": "0.0.1",
  "private": true,
  "description": "EV Maps - Astro + Web Components",
  "type": "module",
  "imports": {
    "#fixtures/*": "./tests/fixtures/*"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "oxlint -c ../dev-config/oxlint.json src tests public scripts",
    "lint:css": "biome lint --config-path=../dev-config src",
    "format": "oxfmt -c ../dev-config/.oxfmtrc.json --ignore-path ../../.gitignore .",
    "format:check": "oxfmt -c ../dev-config/.oxfmtrc.json --ignore-path ../../.gitignore --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:scripts": "bun test scripts",
    "icons": "bun scripts/generate-icons.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.9",
    "@ev-maps/tiles": "workspace:*",
    "@ev-maps/ui": "workspace:*",
    "@simplewebauthn/browser": "^13.3.0",
    "astro": "^7.4.12",
    "idb-keyval": "^6.3.0",
    "lucide-static": "^1.73.0",
    "supercluster": "^9.1.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@ev-maps/dev-config": "workspace:*",
    "@ev-maps/e2e": "workspace:*",
    "@playwright/test": "^1.65.1"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.0.0"
  }
}
