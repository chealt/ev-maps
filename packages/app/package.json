{
  "name": "@ev-maps/app",
  "version": "0.0.1",
  "private": true,
  "description": "EV Maps - Astro + Web Components",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "bun run --cwd ../dev-config lint:js",
    "lint:css": "bun run --cwd ../dev-config lint:css",
    "format": "bunx oxfmt src/**/*.{js,ts,astro}",
    "format:check": "bunx oxfmt --check src/**/*.{js,ts,astro}"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20240117.0",
    "astro": "^4.16.19"
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^10.0.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22.0.0"
  },
  "packageManager": "bun@1.4.4"
}
