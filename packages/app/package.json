{
  "name": "@ev-maps/app",
  "version": "0.0.1",
  "private": true,
  "description": "EV Maps - Astro + Web Components",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "oxlint -c ../dev-config/oxlint.json src tests public",
    "lint:css": "biome lint --config-path=../dev-config src",
    "format": "oxfmt -c ../dev-config/.oxfmtrc.json --ignore-path ../../.gitignore .",
    "format:check": "oxfmt -c ../dev-config/.oxfmtrc.json --ignore-path ../../.gitignore --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug"
  },
  "dependencies": {
    "astro": "^4.16.19",
    "lucide-static": "^1.72.0",
    "supercluster": "^9.1.0"
  },
  "devDependencies": {
    "@ev-maps/dev-config": "workspace:*",
    "@playwright/test": "^1.65.0",
    "wrangler": "4.161.0"
  },
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=26.0.0"
  }
}
