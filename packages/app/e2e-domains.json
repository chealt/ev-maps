{
  "$comment": "Which end-to-end specs a pull request runs (scripts/select-e2e.js): the specs of every domain whose paths it changed, and the tests tagged @regression. A change to `everything`, or to a file under packages/app that no domain lists, runs them all. Paths are from the repository's root; tests are spec names (the specs live next to what they test (packages/app/src/**, packages/admin/components/**)).",
  "everything": [
    "package.json",
    "bun.lock",
    ".github/workflows/app.yml",
    "packages/app/package.json",
    "packages/app/astro.config.mjs",
    "packages/app/playwright.config.js",
    "packages/app/e2e-domains.json",
    "packages/app/scripts/select-e2e.js",
    "packages/app/scripts/e2e-selection.js",
    "packages/e2e/fixtures/**",
    "packages/app/src/layouts/**",
    "packages/app/src/pages/**",
    "packages/app/src/i18n/index.js",
    "packages/app/src/lib/messages.js",
    "packages/app/src/lib/pages.js",
    "packages/app/src/lib/page-data.js",
    "packages/app/src/components/HomePage.*",
    "packages/e2e/**",
    "packages/ui/**",
    "packages/tiles/**"
  ],
  "domains": {
    "map": {
      "paths": [
        "packages/app/src/components/google-map/**",
        "packages/app/src/components/locate-button/**",
        "packages/app/src/config/**",
        "packages/app/src/lib/charger-name.js",
        "packages/app/src/lib/distance.js",
        "packages/app/src/lib/map-center.js",
        "packages/app/src/lib/priciness.js",
        "packages/app/src/lib/maps-app.js",
        "packages/app/src/components/maps-app-picker/**",
        "packages/app/src/i18n/*/map.js",
        "packages/app/public/**"
      ],
      "tests": [
        "google-map",
        "charger-details",
        "navigate",
        "chargers",
        "scrolling",
        "pin-availability",
        "priciness",
        "open-in-maps",
        "nearby",
        "manifest"
      ]
    },
    "filters": {
      "paths": [
        "packages/app/src/components/filter-button/**",
        "packages/app/src/components/google-map/saved-state.js",
        "packages/app/src/lib/account-settings.js"
      ],
      "tests": [
        "power-filter",
        "connector-filter",
        "operator-filter",
        "price-filter",
        "nearby",
        "filter-labels"
      ]
    },
    "routes": {
      "paths": [
        "packages/app/src/components/route-button/**",
        "packages/app/src/components/route-planner/**",
        "packages/app/src/components/place-input/**",
        "packages/app/src/components/place-search/**",
        "packages/app/src/components/google-map/route.js",
        "packages/app/src/components/google-map/route-history.js"
      ],
      "tests": ["route-planner", "favorite-routes", "navigate", "place-search"]
    },
    "motion": {
      "paths": ["packages/app/src/lib/motion.js", "packages/app/src/components/motion-setting/**"],
      "tests": ["motion"]
    },
    "shortcuts": {
      "paths": ["packages/app/src/components/shortcuts-dialog/**"],
      "tests": ["shortcuts"]
    },
    "account": {
      "paths": [
        "packages/app/src/components/user-menu/**",
        "packages/app/src/components/theme-picker/**",
        "packages/app/src/components/language-picker/**",
        "packages/app/src/lib/session.js",
        "packages/app/src/i18n/*/account.js"
      ],
      "tests": ["sign-in", "passkeys", "theme", "languages"]
    },
    "favorites": {
      "paths": [
        "packages/app/src/components/favorites-dialog/**",
        "packages/app/src/lib/favorites.js"
      ],
      "tests": ["favorites"]
    },
    "legal": {
      "paths": ["packages/app/src/components/legal-page/**", "packages/app/src/legal/**"],
      "tests": ["legal"]
    },
    "country pages": {
      "paths": [
        "packages/app/src/lib/page-kind.js",
        "packages/app/tests/fixtures/country-chargers/**"
      ],
      "tests": ["country-page"]
    },
    "translations": {
      "paths": ["packages/app/src/i18n/**"],
      "tests": ["translations", "languages"]
    },
    "reporting": {
      "paths": [
        "packages/app/src/lib/usage.js",
        "packages/app/src/lib/performance.js",
        "packages/app/src/lib/error-reporting.js",
        "packages/app/scripts/**"
      ],
      "tests": ["usage", "performance", "error-reporting", "accessibility"]
    },
    "distances": {
      "paths": [
        "packages/app/src/lib/distance-unit.js",
        "packages/app/src/lib/account-preference.js",
        "packages/app/src/components/distance-text/**",
        "packages/app/src/components/distance-unit-picker/**"
      ],
      "tests": ["distance-unit", "route-planner", "favorites", "nearby", "open-in-maps"]
    },
    "admin": {
      "paths": [
        "packages/admin/components/admin-*/**",
        "packages/app/src/lib/day-count.js",
        "packages/app/src/i18n/*/admin*.js"
      ],
      "tests": ["admin", "admin-errors", "admin-performance", "admin-reports", "admin-usage"]
    }
  }
}
