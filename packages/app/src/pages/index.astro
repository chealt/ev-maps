---
import Layout from '../layouts/Layout.astro';
import '../components/EvMapApp.js';
---

<Layout title="EV Maps - Electric Vehicle Charging Stations">
  <main class="container">
    <h1>EV Maps</h1>
    <p class="subtitle">Find electric vehicle charging stations near you</p>
    
    <ev-map-app client:load></ev-map-app>
  </main>
</Layout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  h1 {
    font-size: 2.5rem;
    font-weight: 700;
    color: #1a1a1a;
    text-align: center;
  }

  .subtitle {
    font-size: 1.25rem;
    color: #666;
    text-align: center;
    max-width: 600px;
  }
</style>
