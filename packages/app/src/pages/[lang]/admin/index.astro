---
import Layout from "../../../layouts/Layout.astro";
import AdminPage from "../../../components/admin-page/AdminPage.astro";
import { translations } from "../../../i18n/index.js";
import { languages } from "../../../lib/pages.js";

// The Worker only serves this page to admins (packages/worker/src/admin.js).
export const getStaticPaths = () => languages().map((lang) => ({ params: { lang } }));

const { lang } = Astro.params;
const { page } = translations(Astro.currentLocale ?? "en");
---

<Layout title={`EV Maps - ${page.admin}`} noindex>
  <AdminPage current="overview">
    <section class="admin-section">
      <h2>{page.adminSections}</h2>
      <ul>
        <li>
          <a class="section-link" href={`/${lang}/admin/errors/`}>
            {page.adminErrors}
          </a>
          {" – "}
          {page.adminErrorsDescription}
        </li>
      </ul>
    </section>
  </AdminPage>
</Layout>
