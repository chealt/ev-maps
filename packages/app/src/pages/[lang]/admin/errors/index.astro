---
import Layout from "../../../../layouts/Layout.astro";
import AdminErrors from "../../../../components/admin-errors/AdminErrors.astro";
import AdminPage from "../../../../components/admin-page/AdminPage.astro";
import { translations } from "../../../../i18n/index.js";
import { pageData } from "../../../../lib/page-data.js";

// Rendered on the server, per request: the Worker only serves it to admins,
// with the errors as its data (packages/worker/src/admin.js).
export const prerender = false;

const { page } = translations(Astro.currentLocale ?? "en");
const error = Astro.url.searchParams.get("error");
const pageNumber = Astro.url.searchParams.get("page") ?? "1";
const data = await pageData(
  Astro,
  error
    ? `/api/admin/errors/${encodeURIComponent(error)}?page=${encodeURIComponent(pageNumber)}`
    : `/api/admin/errors?page=${encodeURIComponent(pageNumber)}`
);
---

<Layout title={`EV Maps - ${page.adminErrors}`} noindex kind="admin">
  <AdminPage current="errors">
    <AdminErrors pageData={data} />
  </AdminPage>
</Layout>
