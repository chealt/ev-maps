---
import Layout from "../../../../layouts/Layout.astro";
import AdminPage from "@ev-maps/admin/components/admin-page/AdminPage.astro";
import AdminSuggestions from "@ev-maps/admin/components/admin-suggestions/AdminSuggestions.astro";
import { translations } from "../../../../i18n/index.js";
import { languages } from "../../../../lib/pages.js";

// The Worker only serves this page to admins (packages/admin/src/admin.js).
export const getStaticPaths = () => languages().map((lang) => ({ params: { lang } }));

const { page } = translations(Astro.currentLocale ?? "en");
---

<Layout title={`EV Maps - ${page.adminSuggestions}`} noindex kind="admin">
  <AdminPage current="suggestions" page={page}>
    <AdminSuggestions page={page} />
  </AdminPage>
</Layout>
