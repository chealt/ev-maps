---
import Layout from "../../../../layouts/Layout.astro";
import AdminPage from "@ev-maps/admin/components/admin-page/AdminPage.astro";
import AdminSuggestions from "@ev-maps/admin/components/admin-suggestions/AdminSuggestions.astro";
import { translations } from "../../../../i18n/index.js";
import { pageData } from "../../../../lib/page-data.js";

// Rendered on the server, per request: the Worker only serves it to admins,
// with the suggestions as its data (packages/worker/src/admin-area.js).
export const prerender = false;

const { page, messages, values } = translations(Astro.currentLocale ?? "en");
const status = Astro.url.searchParams.get("status") ?? "pending";
const data = await pageData(
  Astro,
  `/api/admin/charger-suggestions${status === "all" ? "" : `?status=${encodeURIComponent(status)}`}`
);
---

<Layout title={`EV Maps - ${page.adminSuggestions}`} noindex kind="admin">
  <AdminPage current="suggestions" page={page}>
    <AdminSuggestions pageData={data} page={page} messages={messages} values={values} />
  </AdminPage>
</Layout>
