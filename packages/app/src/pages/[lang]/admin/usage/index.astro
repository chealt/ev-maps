---
import Layout from "../../../../layouts/Layout.astro";
import AdminPage from "@ev-maps/admin/components/admin-page/AdminPage.astro";
import AdminUsage from "@ev-maps/admin/components/admin-usage/AdminUsage.astro";
import { translations } from "../../../../i18n/index.js";
import AdminSubnav from "@ev-maps/admin/components/admin-subnav/AdminSubnav.astro";
import { pageData } from "../../../../lib/page-data.js";
import { usageNavigation } from "../../../../lib/usage-sections.js";

// Rendered on the server, per request: the Worker only serves it to admins,
// with the usage stats of ?days= as its data (packages/worker/src/admin-area.js).
export const prerender = false;

const lang = Astro.currentLocale ?? "en";
const { page, messages, values } = translations(lang);
const days = Astro.url.searchParams.get("days");
const data = await pageData(
  Astro,
  `/api/admin/usage${days ? `?days=${encodeURIComponent(days)}` : ""}`
);

// The events this site counts: the totals at the top, the breakdowns below,
// and how each broken-down event's dimension reads (the values table its
// labels are in).
const totals = [
  "page_view",
  "sign_up",
  "sign_in",
  "route_planned",
  "favorite_added",
  "charger_opened",
  "locate_me",
  "list_opened",
];
const breakdowns = [
  "page_view",
  "visitor_country",
  "charger_opened",
  "filter_used",
  "sign_in_started",
];
const dimensionLabels = {
  charger_opened: "chargerSources",
  filter_used: "filterKinds",
  sign_in_started: "signInMethods",
};
---

<Layout title={`EV Maps - ${page.adminUsage}`} noindex kind="admin">
  <AdminPage current="usage" page={page}>
    <AdminSubnav
      label={page.adminUsagePages}
      items={usageNavigation(lang, page)}
      current="activity"
    />
    <AdminUsage
      pageData={data}
      page={page}
      messages={messages}
      values={values}
      totals={totals}
      breakdowns={breakdowns}
      dimensionLabels={dimensionLabels}
    />
  </AdminPage>
</Layout>
