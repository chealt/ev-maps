---
import Layout from "../../../layouts/Layout.astro";
import SavedPlacesPage from "../../../components/saved-places-page/SavedPlacesPage.astro";
import { translations } from "../../../i18n/index.js";
import { languages } from "../../../lib/pages.js";

export const getStaticPaths = () => languages().map((lang) => ({ params: { lang } }));

const { page } = translations(Astro.currentLocale ?? "en");
---

<Layout title={`EV Maps - ${page.mySavedPlaces}`} noindex>
  <SavedPlacesPage />
</Layout>
