---
import Layout from "../../../layouts/Layout.astro";
import UserSuggestionsPage from "../../../components/user-suggestions/UserSuggestionsPage.astro";
import { translations } from "../../../i18n/index.js";
import { languages } from "../../../lib/pages.js";

export const getStaticPaths = () => languages().map((lang) => ({ params: { lang } }));

const { page } = translations(Astro.currentLocale ?? "en");
---

<Layout title={`EV Maps - ${page.mySuggestedChargers}`} noindex>
  <UserSuggestionsPage />
</Layout>
