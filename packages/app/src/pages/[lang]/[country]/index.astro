---
import Layout from "../../../layouts/Layout.astro";
import HomePage from "../../../components/HomePage.astro";
import {
  chargerBounds,
  countryName,
  languages,
  listCountries,
  pageChargers,
} from "../../../lib/pages.js";
import { fill, translations } from "../../../i18n/index.js";

export const getStaticPaths = () =>
  languages().flatMap((lang) =>
    listCountries().map(({ country, loadChargers }) => ({
      params: { lang, country },
      props: { loadChargers },
    }))
  );

const { lang, country } = Astro.params;
const chargers = await Astro.props.loadChargers();
const { page } = translations(lang);
const name = countryName(country, lang);
const title = fill(page.countryTitle, { country: name });
// For search results and link previews: the country and how many chargers.
const description = fill(page.countryDescription, {
  country: name,
  count: new Intl.NumberFormat(lang).format(chargers.length),
});
---

<Layout title={title} description={description}>
  <HomePage {...pageChargers(chargers)} chargerBounds={chargerBounds(chargers)} />
</Layout>
