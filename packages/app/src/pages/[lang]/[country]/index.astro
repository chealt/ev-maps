---
import Layout from "../../../layouts/Layout.astro";
import HomePage from "../../../components/HomePage.astro";
import {
  chargerBounds,
  countryName,
  languages,
  pageChargers,
  readCountries,
} from "../../../lib/pages.js";
import { fill, translations } from "../../../i18n/index.js";

export const getStaticPaths = async () => {
  const countries = await readCountries();
  return languages().flatMap((lang) =>
    countries.map(({ country, chargers }) => ({
      params: { lang, country },
      props: { chargers },
    }))
  );
};

const { lang, country } = Astro.params;
const { chargers } = Astro.props;
const title = fill(translations(lang).page.countryTitle, { country: countryName(country, lang) });
---

<Layout title={title}>
  <HomePage {...pageChargers(chargers)} chargerBounds={chargerBounds(chargers)} />
</Layout>
