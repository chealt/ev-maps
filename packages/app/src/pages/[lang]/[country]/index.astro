---
import Layout from "../../../layouts/Layout.astro";
import HomePage from "../../../components/HomePage.astro";
import {
  chargerBounds,
  countryName,
  languages,
  listCountries,
  pageChargers,
} from "../../../lib/pages.js";
import { fill, translations } from "../../../i18n/index.js";

export const getStaticPaths = () =>
  languages().flatMap((lang) =>
    listCountries().map(({ country, loadChargers }) => ({
      params: { lang, country },
      props: { loadChargers },
    }))
  );

const { lang, country } = Astro.params;
const chargers = await Astro.props.loadChargers();
const title = fill(translations(lang).page.countryTitle, { country: countryName(country, lang) });
---

<Layout title={title}>
  <HomePage {...pageChargers(chargers)} chargerBounds={chargerBounds(chargers)} />
</Layout>
