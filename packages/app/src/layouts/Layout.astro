---
// Inter, served with the site (no third-party request); each page loads
// only the subsets its text needs (unicode-range): Latin and Latin Extended,
// for Polish and Hungarian.
import "@fontsource-variable/inter/wght.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "./global.css";
import { runtimeTranslations, translations } from "../i18n/index.js";
import { languages } from "../lib/pages.js";
import { defaultUrl } from "../lib/sitemap.js";

interface Props {
  title?: string;
  // Kept out of search engines, e.g. the admin pages.
  noindex?: boolean;
  // The kind of page, for the copy its scripts get: "map", "legal", "admin".
  kind?: string;
}

const lang = Astro.currentLocale ?? "en";
const { page } = translations(lang);
const { title = page.title, noindex = false, kind = "map" } = Astro.props;

// The same page in every language, e.g. /pl/hu/ for /en/hu/.
const pathInLanguage = (language) => Astro.url.pathname.replace(/^\/[^/]+\//, `/${language}/`);
const site = Astro.site ?? Astro.url;
const alternates = languages().map((language) => ({
  language,
  href: new URL(pathInLanguage(language), site).href,
}));
// The page's path after its language, e.g. "hu/" for /en/hu/.
const pagePath = Astro.url.pathname.replace(/^\/[^/]+\/?/, "");

// The scripts' copy (src/lib/messages.js), only this language's and only
// this kind of page's, baked in at build time: the client loads no i18n.
// Pages whose scripts show no copy (the legal pages) get none.
// JSON inside <script>: escape "<" so it can't close the element.
const runtime = runtimeTranslations(lang, kind);
const hasRuntimeCopy =
  Object.keys(runtime.messages).length > 0 || Object.keys(runtime.values).length > 0;
const messagesJson = JSON.stringify(runtime).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={page.description} />
    <!-- No AI training or reuse; see the terms and public/robots.txt. -->
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow, noai, noimageai" : "noai, noimageai"}
    />
    <meta name="theme-color" content="#059669" />
    <!-- Every page's text is mostly Latin: fetched with the HTML, so it
         doesn't show in another font first. -->
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href={`/${lang}/manifest.webmanifest`} />
    <title>{title}</title>
    {alternates.map(({ language, href }) => (
      <link rel="alternate" hreflang={language} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={defaultUrl(site, pagePath)} />
    <!-- The page's one address for search engines: without query strings,
         and not / (which redirects); the sitemap lists the same. -->
    {!noindex && <link rel="canonical" href={new URL(Astro.url.pathname, site).href} />}
    {hasRuntimeCopy && <script type="application/json" id="messages" set:html={messagesJson} />}
    <!-- Traces the page's API calls and measures its Web Vitals, for the
         admin area; first, so it sees every call. -->
    <script src="../lib/performance.js"></script>
    <!-- Sends the page's uncaught errors to the admin area. -->
    <script src="../lib/error-reporting.js"></script>
    <!-- Counts page views and events for the admin area's usage stats. -->
    <script src="../lib/usage.js"></script>
    <!-- Applies the saved theme and motion setting before the first paint, so
         the page doesn't flash the wrong theme or animate when it shouldn't.
         It must stay inline to run before rendering. -->
    <script is:inline>
      try {
        const theme = localStorage.getItem("ev-maps:theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
        // Animations the user turned off (src/lib/motion.js).
        if (localStorage.getItem("ev-maps:animations") === "off") {
          document.documentElement.dataset.animations = "off";
        }
      } catch {
        // Storage can be unavailable; the system theme applies.
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
