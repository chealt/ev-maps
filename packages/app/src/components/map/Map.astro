---
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = 'EV Charging Stations Map', subtitle = 'EV charging stations will appear here' } = Astro.props;

// Import Button component
import Button from '../button/Button.astro';
---

<div class="map-container">
  <div class="map-placeholder">
    <h2>{title}</h2>
    <p>{subtitle}</p>
  </div>
  <div class="controls">
    <!-- Buttons will be enhanced by Web Components -->
    <ev-button data-action="locate">
      <Button variant="primary">Locate Me</Button>
    </ev-button>
    <ev-button data-action="filters">
      <Button variant="secondary">Filters</Button>
    </ev-button>
  </div>
  <div class="status"></div>
</div>
