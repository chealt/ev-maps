---
interface Props {
  title?: string;
  subtitle?: string;
}

const { title = 'EV Charging Stations Map', subtitle = 'EV charging stations will appear here' } = Astro.props;

// Import Button component
import Button from '../button/Button.astro';
---

<div class="map-container" data-status>
  <div class="map-placeholder">
    <h2>{title}</h2>
    <p>{subtitle}</p>
  </div>
  <div class="controls">
    <ev-locate-button>
      <Button variant="primary" data-action="locate">Locate Me</Button>
    </ev-locate-button>
    <ev-filter-button>
      <Button variant="secondary" data-action="filters">Filters</Button>
    </ev-filter-button>
  </div>
  <div class="status"></div>
</div>
