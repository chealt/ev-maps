---
import DistanceText from "../distance-text/DistanceText.astro";
import { CORRIDOR_KM, CORRIDOR_OPTIONS_KM } from "../google-map/route.js";
import { Heart, History, LocateFixed, X } from "lucide-static";
import Button from "@ev-maps/ui/Button.astro";
import Icon from "@ev-maps/ui/Icon.astro";
import PlaceInput from "../place-input/PlaceInput.astro";
import { translations } from "../../i18n/index.js";
import "./RoutePlanner.css";

interface Props {
  id: string;
}

const { id } = Astro.props;
const { page } = translations(Astro.currentLocale ?? "en");
---

<ev-route-planner>
  <dialog class="fullscreen-dialog route-planner" id={id} aria-labelledby="route-planner-title">
    <div class="header">
      <h2 class="title" id="route-planner-title">
        {page.routePlanner}
      </h2>
      <Button variant="ghost" size="icon-only" class="close" aria-label={page.closeRoutePlanner}>
        <Icon icon={X} />
      </Button>
    </div>
    <form class="body" id="route-planner-form" novalidate>
      <div class="sign-in-needed" hidden>
        <p>{page.signInForRoutes}</p>
        <Button variant="primary" class="sign-in-button">
          {page.signIn}
        </Button>
      </div>
      <PlaceInput id="route-from" label={page.routeFrom} placeholder={page.placeSearch}>
        <Button variant="ghost" size="small" class="use-my-location">
          <Icon icon={LocateFixed} size="sm" />
          {page.useMyLocation}
        </Button>
      </PlaceInput>
      <PlaceInput id="route-to" label={page.routeTo} placeholder={page.placeSearch} />
      <!-- How far from the route chargers are shown; the labels and the hint
           are in the user's unit once the page runs (DistanceText.js). -->
      <fieldset class="corridor">
        <legend class="label">{page.routeCorridorLegend}</legend>
        <div class="corridor-options">
          {CORRIDOR_OPTIONS_KM.map((km) => (
            <label class="corridor-option">
              <input type="radio" name="corridor-km" value={km} checked={km === CORRIDOR_KM} />
              <span class="distance-text" data-meters={km * 1000}>
                {new Intl.NumberFormat(Astro.currentLocale ?? "en", {
                  style: "unit",
                  unit: "kilometer",
                }).format(km)}
              </span>
            </label>
          ))}
        </div>
      </fieldset>
      <DistanceText
        class="hint corridor-hint"
        template={page.routeCorridor}
        meters={CORRIDOR_KM * 1000}
      />
      <p class="error" role="alert"></p>
      <!-- The routes saved as favorites, then the others planned before,
           each with the filters on then; choosing one plans it again with
           them, and its heart saves or removes it (route-history.js). -->
      <section class="recent-routes favorite-routes" aria-labelledby="favorite-routes-title" hidden>
        <h3 class="subtitle" id="favorite-routes-title">
          <Icon icon={Heart} size="sm" />
          {page.favoriteRoutes}
        </h3>
        <ol class="recent-route-list"></ol>
      </section>
      <section class="recent-routes history" aria-labelledby="recent-routes-title" hidden>
        <h3 class="subtitle" id="recent-routes-title">
          <Icon icon={History} size="sm" />
          {page.recentRoutes}
        </h3>
        <ol class="recent-route-list"></ol>
      </section>
      <template class="recent-route-template">
        <li class="route-item">
          <button type="button" class="recent-route">
            <span class="route-ends"></span>
            <span class="route-filters"></span>
          </button>
          <Button variant="ghost" size="icon-only" class="favorite-route" aria-pressed="false">
            <Icon icon={Heart} />
          </Button>
        </li>
      </template>
    </form>
    <div class="footer">
      <Button variant="secondary" size="large" class="clear-route" disabled>
        {page.clearRoute}
      </Button>
      <Button variant="primary" size="large" type="submit" form="route-planner-form">
        {page.showRoute}
      </Button>
    </div>
  </dialog>
  <script src="./RoutePlanner.js"></script>
</ev-route-planner>
