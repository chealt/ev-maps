---
import Button from "@ev-maps/ui/Button.astro";
import Dialog from "@ev-maps/ui/Dialog.astro";
import { MapPin, Navigation, Search } from "lucide-static";
import Icon from "@ev-maps/ui/Icon.astro";
import PlaceInput from "../place-input/PlaceInput.astro";
import { translations } from "../../i18n/index.js";
import "./PlaceSearch.css";

const { page } = translations(Astro.currentLocale ?? "en");
---

<ev-place-search>
  <Button
    variant="secondary"
    class="search-place-button"
    aria-haspopup="dialog"
    aria-controls="place-search"
    aria-keyshortcuts="s"
  >
    <Icon icon={Search} />
    <span class="label">{page.search}</span>
  </Button>
  <Dialog
    class="place-search-dialog"
    id="place-search"
    title={page.search}
    titleId="place-search-title"
    closeLabel={page.close}
  >
    <PlaceInput id="place-search-input" label={page.search} placeholder={page.placeSearch} />
    <div class="actions">
      <Button variant="primary" size="large" class="search-here" disabled>
        <Icon icon={MapPin} size="sm" />
        {page.showOnMap}
      </Button>
      <Button variant="secondary" size="large" class="plan-route-here" disabled>
        <Icon icon={Navigation} size="sm" />
        {page.navigate}
      </Button>
    </div>
  </Dialog>
  <script src="./PlaceSearch.js"></script>
</ev-place-search>
