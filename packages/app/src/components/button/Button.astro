---
import './Button.css';

interface Props {
  variant?: 'primary' | 'secondary' | 'danger';
  size?: 'small' | 'medium' | 'large';
  disabled?: boolean;
}

const { 
  variant = 'primary', 
  size = 'medium', 
  disabled = false
} = Astro.props;

const buttonClasses = [
  'button',
  `button--${variant}`,
  `button--${size}`,
  disabled ? 'button--disabled' : ''
].filter(Boolean).join(' ');
---

<button 
  class={buttonClasses}
  ?disabled={disabled}
>
  <slot />
</button>
