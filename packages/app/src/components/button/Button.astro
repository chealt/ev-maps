---
import './Button.css';

interface Props {
  variant?: 'primary' | 'secondary' | 'danger';
  size?: 'small' | 'medium' | 'large';
  disabled?: boolean;
}

const { 
  variant = 'primary', 
  size = 'medium', 
  disabled = false
} = Astro.props;
---

<button 
  class={`button button--${variant} button--${size}${disabled ? ' button--disabled' : ''}`}
  ?disabled={disabled}
>
  <slot />
</button>
