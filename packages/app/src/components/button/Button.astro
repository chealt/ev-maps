---
import type { HTMLAttributes } from "astro/types";
import "./Button.css";

interface Props extends HTMLAttributes<"button"> {
  variant?: "primary" | "secondary" | "ghost" | "danger";
  size?: "small" | "medium" | "large" | "icon-only";
}

const {
  variant = "primary",
  size = "medium",
  type = "button",
  class: className,
  ...attrs
} = Astro.props;
---

<button type={type} class:list={["button", variant, size, className]} {...attrs}>
  <slot />
</button>
