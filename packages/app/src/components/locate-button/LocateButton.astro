---
import { LocateFixed } from "lucide-static";
import IconButton from "../icon-button/IconButton.astro";

interface Props {
  autoLocate?: boolean;
}

const { autoLocate = false } = Astro.props;
---

<ev-locate-button data-auto-locate={autoLocate ? "" : undefined}>
  <IconButton icon={LocateFixed} label="Locate me" variant="primary" class="locate-button" />
  <script src="./LocateButton.js"></script>
</ev-locate-button>
