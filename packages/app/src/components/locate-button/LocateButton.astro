---
import Button from "@ev-maps/ui/Button.astro";
import { LocateFixed } from "lucide-static";
import Icon from "@ev-maps/ui/Icon.astro";
import { translations } from "../../i18n/index.js";

interface Props {
  autoLocate?: boolean;
}

const { autoLocate = false } = Astro.props;
const { page } = translations(Astro.currentLocale ?? "en");
---

<!-- Icon only: it sits in the top bar, next to the account menu, where text
     would take map space. -->
<ev-locate-button data-auto-locate={autoLocate ? "" : undefined}>
  <Button
    variant="primary"
    size="icon-only"
    class="locate-button"
    aria-label={page.locate}
    aria-keyshortcuts="l"
  >
    <Icon icon={LocateFixed} />
  </Button>
  <script src="./LocateButton.js"></script>
</ev-locate-button>
