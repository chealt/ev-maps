---
import Button from "../button/Button.astro";
import Icon from "../icon/Icon.astro";

interface Props {
  autoLocate?: boolean;
}

const { autoLocate = false } = Astro.props;
---

<ev-locate-button data-auto-locate={autoLocate ? "" : undefined}>
  <Button variant="primary" class="locate-button">
    <Icon name="locate" />
    <span class="button__label">Locate Me</span>
  </Button>
  <script src="./LocateButton.js"></script>
</ev-locate-button>
