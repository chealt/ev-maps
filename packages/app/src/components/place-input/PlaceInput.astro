---
import { X } from "lucide-static";
import Button from "@ev-maps/ui/Button.astro";
import Field from "@ev-maps/ui/Field.astro";
import Icon from "@ev-maps/ui/Icon.astro";
import "./PlaceInput.css";

interface Props {
  id: string;
  label: string;
  placeholder: string;
  clearLabel?: string;
}

const { id, label, placeholder, clearLabel } = Astro.props;
const listId = `${id}-options`;
---

<ev-place-input class="place-input">
  <Field label={label} for={id}>
    {Astro.slots.has("default") && (
      <Fragment slot="actions">
        <slot />
      </Fragment>
    )}
    <input
      id={id}
      class="field-control"
      type="text"
      role="combobox"
      autocomplete="off"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={listId}
      placeholder={placeholder}
    />
    {clearLabel && (
      <Button variant="ghost" size="icon-only" class="clear-place" aria-label={clearLabel} hidden>
        <Icon icon={X} size="sm" />
      </Button>
    )}
  </Field>
  <slot name="after" />
  <ul class="options" id={listId} role="listbox" aria-label={label} hidden></ul>
  <template class="option-template">
    <li class="option" role="option" aria-selected="false">
      <span class="main"></span>
      <span class="secondary"></span>
    </li>
  </template>
  <script src="./PlaceInput.js"></script>
</ev-place-input>
