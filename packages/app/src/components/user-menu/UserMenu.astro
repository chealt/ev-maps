---
import {
  Bookmark,
  ClipboardList,
  Coffee,
  Heart,
  KeyRound,
  LogOut,
  Mail,
  MapPinPlus,
  Scan,
  ShieldCheck,
  Zap,
} from "lucide-static";
import Button from "@ev-maps/ui/Button.astro";
import Field from "@ev-maps/ui/Field.astro";
import Icon from "@ev-maps/ui/Icon.astro";
import LanguagePicker from "../language-picker/LanguagePicker.astro";
import LocateButton from "../locate-button/LocateButton.astro";
import ThemePicker from "../theme-picker/ThemePicker.astro";
import MapsAppPicker from "../maps-app-picker/MapsAppPicker.astro";
import DistanceUnitPicker from "../distance-unit-picker/DistanceUnitPicker.astro";
import CarPicker from "../car-picker/CarPicker.astro";
import MotionSetting from "../motion-setting/MotionSetting.astro";
import SavedPlacesSetting from "../saved-places-setting/SavedPlacesSetting.astro";
import { fill, translations } from "../../i18n/index.js";
import { supportLinks } from "../../lib/support-links.js";
import AppleLogo from "./apple-logo.svg";
import GitHubLogo from "./github-logo.svg";
import GoogleLogo from "./google-logo.svg";
import MicrosoftLogo from "./microsoft-logo.svg";
import "./UserMenu.css";

// Every sign-in provider the Worker knows (packages/worker/src/auth.js).
// Hidden until the Worker says it has credentials for them.
const providers = [
  { id: "google", name: "Google", logo: GoogleLogo },
  { id: "github", name: "GitHub", logo: GitHubLogo },
  { id: "microsoft", name: "Microsoft", logo: MicrosoftLogo },
  { id: "apple", name: "Apple", logo: AppleLogo },
];

interface Props {
  // Said to screen readers below the app's name.
  subtitle: string;
  // Locate Me asks for the location once the map is ready, if permitted.
  autoLocate?: boolean;
}

const { subtitle, autoLocate = false } = Astro.props;
const lang = Astro.currentLocale ?? "en";
const { page } = translations(lang);
---

<ev-user-menu class="user-menu">
  <!-- One box: the app's name (the page's heading) and the account button,
       whose click area covers the whole box. The name is visible because
       Google's OAuth verification checks that the home page shows the same
       name as the consent screen. -->
  <!-- The map's own actions, icon-only, in the top bar next to the account
       menu so they don't take map space in the map controls: Locate Me, and
       with a route shown, zooming back out to the whole route. -->
  <div class="map-actions">
    <Button
      variant="secondary"
      size="icon-only"
      class="zoom-route"
      aria-label={page.zoomToRoute}
      hidden
    >
      <Icon icon={Scan} />
    </Button>
    <LocateButton autoLocate={autoLocate} />
  </div>
  <div class="bar">
    <hgroup class="brand">
      <span class="mark">
        <Icon icon={Zap} filled />
      </span>
      <h1 class="app-name">EV Maps</h1>
      <p class="visually-hidden">{subtitle}</p>
    </hgroup>
    <button
      type="button"
      class="menu-button"
      popovertarget="account-menu"
      aria-keyshortcuts="a"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-busy="true"
    >
      <!-- Until the session is known: neither "Sign in" nor the avatar. -->
      <span class="loading" aria-hidden="true"></span>
      <!-- The button's name while loading, and signed in ("Account: …"); from
           its content, not aria-label, so it includes what it shows. -->
      <span class="account-name visually-hidden">{page.loadingAccount}</span>
      <!-- Signed out, the button is named Sign in; the box shows the app's name. -->
      <span class="sign-in-label visually-hidden" hidden>
        {page.signIn}
      </span>
      <!-- The avatar and its sponsor badge, which sits on its corner. -->
      <span class="avatar-wrap">
        <span class="avatar" hidden>
          <img class="picture" alt="" referrerpolicy="no-referrer" hidden />
          <span class="initials" aria-hidden="true"></span>
        </span>
        <!-- On sponsors' avatars (GET /api/sponsor/me); outside the avatar,
             which clips its picture to a circle. Part of the button's name. -->
        <span class="sponsor-badge" role="img" aria-label={page.sponsorBadge} hidden>
          <Icon icon={Heart} size="sm" filled />
        </span>
      </span>
    </button>
  </div>

  <div class="account-menu" id="account-menu" popover role="dialog" aria-label={page.account}>
    <div class="profile" hidden>
      <p class="label">{page.signedInAs}</p>
      <p class="name"></p>
      <p class="email"></p>
      <p class="sponsor-thanks" hidden>
        <Icon icon={Heart} size="sm" />
        {page.sponsorThanks}
      </p>
      <!-- Signed in without a passkey yet: offer one, for next time. -->
      <div class="passkey-setup" hidden>
        <Button variant="secondary" size="small" class="add-passkey">
          <Icon icon={KeyRound} size="sm" />
          {page.addPasskey}
        </Button>
        <p class="hint">{page.addPasskeyHint}</p>
      </div>
      <p class="passkey-status" role="status"></p>
    </div>
    <section class="sign-in unavailable" aria-labelledby="sign-in-title">
      <h2 class="legend" id="sign-in-title">
        {page.signIn}
      </h2>
      {providers.map(({ id, name, logo: Logo }) => (
        <button type="button" class="provider" data-provider={id} hidden>
          <Logo class="provider-logo" aria-hidden="true" />
          {fill(page.signInWith, { provider: name })}
        </button>
      ))}
      <button type="button" class="provider passkey" data-method="passkey" hidden>
        <Icon icon={KeyRound} size="sm" />
        {page.signInWithPasskey}
      </button>
      <form class="email-sign-in" data-method="email" hidden>
        <p class="divider">{page.orWithEmail}</p>
        <Field label={page.emailAddress} class="email-field">
          <input
            class="field-control email-input"
            type="email"
            name="email"
            required
            autocomplete="email"
            spellcheck="false"
          />
        </Field>
        <button type="submit" class="provider email-link">
          <Icon icon={Mail} size="sm" />
          {page.emailMeALink}
        </button>
        <p class="hint">{page.emailLinkHint}</p>
      </form>
      <p class="sent" role="status"></p>
      <p class="error" role="alert"></p>
    </section>
    <div class="favorites">
      <Button
        variant="ghost"
        class="favorites-button"
        aria-keyshortcuts="h"
        aria-disabled="true"
        aria-describedby="favorites-sign-in-hint"
      >
        <Icon icon={Heart} size="sm" />
        {page.favorites}
      </Button>
      <p class="hint" id="favorites-sign-in-hint">
        {page.signInForFavorites}
      </p>
      <Button
        variant="ghost"
        class="suggest-charger-button"
        aria-keyshortcuts="n"
        aria-disabled="true"
        aria-describedby="suggest-charger-sign-in-hint"
      >
        <Icon icon={MapPinPlus} size="sm" />
        {page.suggestCharger}
      </Button>
      <p class="hint" id="suggest-charger-sign-in-hint">
        {page.signInToSuggestCharger}
      </p>
      <a class="my-suggestions-link" href={`/${lang}/suggestions/`} hidden>
        <Icon icon={ClipboardList} size="sm" />
        {page.mySuggestedChargers}
      </a>
      <a class="my-saved-places-link" href={`/${lang}/places/`} aria-keyshortcuts="p" hidden>
        <Icon icon={Bookmark} size="sm" />
        {page.mySavedPlaces}
      </a>
      <SavedPlacesSetting />
    </div>
    <ThemePicker />
    <MapsAppPicker />
    <DistanceUnitPicker />
    <CarPicker />
    <MotionSetting />
    <LanguagePicker />
    <Button variant="danger" class="sign-out" hidden>
      <Icon icon={LogOut} size="sm" />
      {page.signOut}
    </Button>
    <!-- Only for admins: the Worker says who is one (/api/admin/me). -->
    <a class="admin-link" href={`/${lang}/admin/`} hidden>
      <Icon icon={ShieldCheck} size="sm" />
      {page.admin}
    </a>
    <!-- Donations, for everyone (src/lib/support-links.js); hidden while no
         platform is enabled. -->
    {supportLinks(lang).length > 0 && (
      <section class="support" aria-labelledby="support-title">
        <h2 class="legend" id="support-title">
          <Icon icon={Coffee} size="sm" />
          {page.supportTitle}
        </h2>
        <p class="hint">{page.supportHint}</p>
        <ul class="support-links">
          {supportLinks(lang).map(({ id, name, url }) => (
            <li>
              <a href={url} data-support={id} target="_blank" rel="noopener">
                {name}
                <span class="visually-hidden">{page.opensInNewTab}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    <nav class="legal" aria-label={page.legal}>
      <a href={`/${lang}/privacy/`}>{page.privacyPolicy}</a>
      <a href={`/${lang}/terms/`}>{page.termsOfUse}</a>
    </nav>
  </div>
  <script src="./UserMenu.js"></script>
</ev-user-menu>
