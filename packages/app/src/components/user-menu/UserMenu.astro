---
import { LogOut, Zap } from "lucide-static";
import Button from "../button/Button.astro";
import Icon from "../icon/Icon.astro";
import LanguagePicker from "../language-picker/LanguagePicker.astro";
import ThemePicker from "../theme-picker/ThemePicker.astro";
import { fill, translations } from "../../i18n/index.js";
import AppleLogo from "./apple-logo.svg";
import GitHubLogo from "./github-logo.svg";
import GoogleLogo from "./google-logo.svg";
import MicrosoftLogo from "./microsoft-logo.svg";
import "./UserMenu.css";

// Every sign-in provider the Worker knows (packages/worker/src/auth.js).
// Hidden until the Worker says it has credentials for them.
const providers = [
  { id: "google", name: "Google", logo: GoogleLogo },
  { id: "github", name: "GitHub", logo: GitHubLogo },
  { id: "microsoft", name: "Microsoft", logo: MicrosoftLogo },
  { id: "apple", name: "Apple", logo: AppleLogo },
];

const lang = Astro.currentLocale ?? "en";
const { page } = translations(lang);
---

<ev-user-menu class="user-menu">
  <button
    type="button"
    class="menu-button"
    popovertarget="account-menu"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-busy="true"
    aria-label={page.loadingAccount}
  >
    <span class="mark">
      <Icon icon={Zap} filled />
    </span>
    <!-- Until the session is known: neither "Sign in" nor the avatar. -->
    <span class="loading" aria-hidden="true"></span>
    <span class="sign-in-label" hidden>
      {page.signIn}
    </span>
    <span class="avatar" hidden>
      <img class="picture" alt="" referrerpolicy="no-referrer" hidden />
      <span class="initials" aria-hidden="true"></span>
    </span>
  </button>

  <div class="account-menu" id="account-menu" popover role="dialog" aria-label={page.account}>
    <div class="profile" hidden>
      <p class="label">{page.signedInAs}</p>
      <p class="name"></p>
      <p class="email"></p>
    </div>
    <section class="sign-in unavailable" aria-labelledby="sign-in-title">
      <h2 class="legend" id="sign-in-title">
        {page.signIn}
      </h2>
      {providers.map(({ id, name, logo: Logo }) => (
        <button type="button" class="provider" data-provider={id} hidden>
          <Logo class="provider-logo" aria-hidden="true" />
          {fill(page.signInWith, { provider: name })}
        </button>
      ))}
      <p class="error" role="alert"></p>
    </section>
    <ThemePicker />
    <LanguagePicker />
    <Button variant="ghost" class="sign-out" hidden>
      <Icon icon={LogOut} size="sm" />
      {page.signOut}
    </Button>
    <nav class="legal" aria-label={page.legal}>
      <a href={`/${lang}/privacy/`}>{page.privacyPolicy}</a>
      <a href={`/${lang}/terms/`}>{page.termsOfUse}</a>
    </nav>
  </div>
  <script src="./UserMenu.js"></script>
</ev-user-menu>
