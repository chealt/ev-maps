---
import Button from "@ev-maps/ui/Button.astro";
import { Route, RouteOff, Scan } from "lucide-static";
import Icon from "@ev-maps/ui/Icon.astro";
import { translations } from "../../i18n/index.js";
import "./RouteButton.css";

interface Props {
  controls?: string;
}

const { controls } = Astro.props;
const { page } = translations(Astro.currentLocale ?? "en");
---

<!-- With a route shown, compact halves appear attached to the route button
     instead of separate buttons taking map space: zoom out to the whole
     route, and clear it. -->
<ev-route-button>
  <span class="split">
    <Button
      variant="secondary"
      class="route-button"
      aria-haspopup="dialog"
      aria-controls={controls}
      aria-keyshortcuts="r"
    >
      <Icon icon={Route} />
      <span class="label">{page.route}</span>
    </Button>
    <Button
      variant="secondary"
      size="icon-only"
      class="zoom-route"
      aria-label={page.zoomToRoute}
      hidden
    >
      <Icon icon={Scan} />
    </Button>
    <Button
      variant="secondary"
      size="icon-only"
      class="clear-route"
      aria-label={page.clearRoute}
      aria-keyshortcuts="x"
      hidden
    >
      <Icon icon={RouteOff} />
    </Button>
  </span>
  <script src="./RouteButton.js"></script>
</ev-route-button>
