---
import { MapPinned } from "lucide-static";
import Icon from "@ev-maps/ui/Icon.astro";
import Switch from "@ev-maps/ui/Switch.astro";
import { translations } from "../../i18n/index.js";
import "./SavedPlacesSetting.css";

const { page } = translations(Astro.currentLocale ?? "en");
---

<!-- The saved places' pins on the map, on by default; signed in only, as
     saved places are (src/lib/saved-places-on-map.js). -->
<ev-saved-places-setting hidden>
  <Switch class="saved-places-on-map" labelClass="saved-places-switch" checked>
    <Icon icon={MapPinned} size="sm" />
    {page.savedPlacesOnMap}
  </Switch>
  <script src="./SavedPlacesSetting.js"></script>
</ev-saved-places-setting>
