---
import Button from "../button/Button.astro";
import { Info, MapPin, PlugZap, X, Zap } from "lucide-static";
import Icon from "../icon/Icon.astro";
import LocateButton from "../locate-button/LocateButton.astro";
import FilterButton from "../filter-button/FilterButton.astro";
import "./GoogleMap.css";

interface Props {
  apiKey?: string;
  openChargeMapKey?: string;
  mapId?: string;
  centerLat?: number;
  centerLng?: number;
  zoom?: number;
  locatedZoom?: number;
  autoLocate?: boolean;
  minChargerZoom?: number;
  showEvChargers?: boolean;
}

const {
  apiKey = "",
  openChargeMapKey = "",
  mapId = "DEMO_MAP_ID",
  centerLat = 0,
  centerLng = 0,
  zoom = 12,
  locatedZoom = 14,
  autoLocate = true,
  minChargerZoom = 8,
  showEvChargers = true,
} = Astro.props;
---

<ev-google-map
  data-api-key={apiKey}
  data-open-charge-map-key={openChargeMapKey}
  data-map-id={mapId}
  data-center-lat={centerLat}
  data-center-lng={centerLng}
  data-zoom={zoom}
  data-located-zoom={locatedZoom}
  data-min-charger-zoom={minChargerZoom}
  data-show-ev-chargers={String(showEvChargers)}
>
  <div class="google-map-container">
    <div class="google-map" role="region" aria-label="EV charging station map"></div>

    <div class="map-status" role="status" aria-live="polite" data-state={apiKey ? "idle" : "error"}>
      {!apiKey && "Google Maps API key is missing. Set VITE_GOOGLE_MAPS_API_KEY."}
    </div>

    <div class="map-controls">
      <LocateButton autoLocate={autoLocate} />
      <FilterButton controls="map-filter-panel" />
    </div>

    <form class="filter-panel" id="map-filter-panel" aria-labelledby="filter-panel-title" hidden>
      <h2 class="title" id="filter-panel-title">
        Filters
      </h2>
      <label class="field">
        <span>Show EV chargers</span>
        <input
          class="switch"
          type="checkbox"
          role="switch"
          name="showEvChargers"
          checked={showEvChargers}
        />
      </label>
    </form>

    <aside class="charger-details" aria-labelledby="charger-details-name" hidden>
      <div class="header">
        <span class="badge">
          <Icon icon={Zap} size="sm" />
          EV charging
        </span>
        <Button variant="ghost" size="icon-only" class="close" aria-label="Close">
          <Icon icon={X} />
        </Button>
      </div>
      <h2 class="name" id="charger-details-name"></h2>
      <p class="address">
        <Icon icon={MapPin} size="sm" />
        <span class="text"></span>
      </p>
      <section class="section">
        <h3 class="title">
          <Icon icon={PlugZap} size="sm" />
          Connectors
        </h3>
        <ul class="connectors"></ul>
      </section>
      <section class="section">
        <h3 class="title">
          <Icon icon={Info} size="sm" />
          Details
        </h3>
        <ul class="details"></ul>
      </section>
      <p class="attribution">
        Charging data from
        <a href="https://openchargemap.org" target="_blank" rel="noopener">
          Open Charge Map
        </a>
      </p>
      <template class="item-template">
        <li></li>
      </template>
    </aside>

    <template class="charger-marker-template">
      <div class="charger-marker">
        <Icon icon={Zap} filled size="sm" />
      </div>
    </template>
  </div>
  <script src="./GoogleMap.js"></script>
</ev-google-map>
