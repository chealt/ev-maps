---
import { ScanSearch, X } from "lucide-static";
import IconButton from "../icon-button/IconButton.astro";
import LocateButton from "../locate-button/LocateButton.astro";
import FilterButton from "../filter-button/FilterButton.astro";
import "./GoogleMap.css";

interface Props {
  apiKey?: string;
  mapId?: string;
  clientId?: string;
  centerLat?: number;
  centerLng?: number;
  zoom?: number;
  locatedZoom?: number;
  autoLocate?: boolean;
  searchRadius?: number;
  showEvChargers?: boolean;
}

const {
  apiKey = "",
  mapId = "DEMO_MAP_ID",
  clientId = "",
  centerLat = 0,
  centerLng = 0,
  zoom = 12,
  locatedZoom = 14,
  autoLocate = true,
  searchRadius = 5000,
  showEvChargers = true,
} = Astro.props;

const radiusOptions = [1000, 5000, 10000, 25000];
---

<ev-google-map
  data-api-key={apiKey}
  data-map-id={mapId}
  data-client-id={clientId}
  data-center-lat={centerLat}
  data-center-lng={centerLng}
  data-zoom={zoom}
  data-located-zoom={locatedZoom}
  data-search-radius={searchRadius}
  data-show-ev-chargers={String(showEvChargers)}
>
  <div class="google-map-container">
    <div class="google-map" role="region" aria-label="EV charging station map"></div>

    <div class="map-status" role="status" aria-live="polite">
      {!apiKey && "Google Maps API key is missing. Set VITE_GOOGLE_MAPS_API_KEY."}
    </div>

    <div class="map-toolbar">
      <div class="map-controls">
        {clientId && <div class="google-signin-button"></div>}
        <LocateButton autoLocate={autoLocate} />
        <IconButton
          icon={ScanSearch}
          label="Search this area"
          variant="secondary"
          class="search-area-button"
        />
        <FilterButton controls="map-filter-panel" />
      </div>

      <form class="filter-panel" id="map-filter-panel" hidden>
        <label class="filter-panel__field">
          <input type="checkbox" name="showEvChargers" checked={showEvChargers} />
          Show EV chargers
        </label>
        <label class="filter-panel__field">
          Search radius
          <select name="searchRadius">
            {radiusOptions.map((radius) => (
              <option value={radius} selected={radius === searchRadius}>
                {radius / 1000} km
              </option>
            ))}
          </select>
        </label>
      </form>
    </div>

    <aside class="charger-details" aria-labelledby="charger-details-name" hidden>
      <IconButton
        icon={X}
        label="Close"
        variant="secondary"
        iconOnly
        class="charger-details__close"
      />
      <h2 class="charger-details__name" id="charger-details-name"></h2>
      <p class="charger-details__address"></p>
      <ul class="charger-details__connectors"></ul>
      <ul class="charger-details__hours"></ul>
      <img class="charger-details__photo" alt="" hidden />
    </aside>

    <template class="charger-details__item-template">
      <li></li>
    </template>
  </div>
  <script src="./GoogleMap.js"></script>
</ev-google-map>
