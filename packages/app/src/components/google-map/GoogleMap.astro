---
import Button from "../button/Button.astro";
import { FilterX, Info, MapPin, PlugZap, X, Zap } from "lucide-static";
import Icon from "../icon/Icon.astro";
import LocateButton from "../locate-button/LocateButton.astro";
import FilterButton from "../filter-button/FilterButton.astro";
import "./GoogleMap.css";

interface Props {
  apiKey?: string;
  openChargeMapKey?: string;
  mapId?: string;
  centerLat?: number;
  centerLng?: number;
  zoom?: number;
  locatedZoom?: number;
  autoLocate?: boolean;
  minChargerZoom?: number;
}

const powerRanges = [
  { value: "under-50", label: "< 50 kW", minKw: 0, maxKw: 50 },
  { value: "50-150", label: "50–150 kW", minKw: 50, maxKw: 150 },
  { value: "150-300", label: "150–300 kW", minKw: 150, maxKw: 300 },
  { value: "300-plus", label: "300+ kW", minKw: 300 },
];

const {
  apiKey = "",
  openChargeMapKey = "",
  mapId = "DEMO_MAP_ID",
  centerLat = 0,
  centerLng = 0,
  zoom = 12,
  locatedZoom = 14,
  autoLocate = true,
  minChargerZoom = 9,
} = Astro.props;
---

<ev-google-map
  data-api-key={apiKey}
  data-open-charge-map-key={openChargeMapKey}
  data-map-id={mapId}
  data-center-lat={centerLat}
  data-center-lng={centerLng}
  data-zoom={zoom}
  data-located-zoom={locatedZoom}
  data-min-charger-zoom={minChargerZoom}
>
  <div class="google-map-container">
    <div class="google-map" role="region" aria-label="EV charging station map"></div>

    <div class="map-status" role="status" aria-live="polite" data-state={apiKey ? "idle" : "error"}>
      {!apiKey && "Google Maps API key is missing. Set VITE_GOOGLE_MAPS_API_KEY."}
    </div>

    <div class="map-controls">
      <LocateButton autoLocate={autoLocate} />
      <FilterButton controls="map-filter-panel" />
      <Button variant="secondary" class="clear-filters" hidden>
        <Icon icon={FilterX} />
        <span class="label">Clear filters</span>
      </Button>
    </div>

    <dialog class="filter-dialog" id="map-filter-panel" aria-labelledby="filter-panel-title">
      <div class="header">
        <h2 class="title" id="filter-panel-title">
          Filters
        </h2>
        <Button variant="ghost" size="icon-only" class="close" aria-label="Close filters">
          <Icon icon={X} />
        </Button>
      </div>
      <div class="body">
        <div class="group" role="group" aria-labelledby="power-filter-title">
          <h3 class="subtitle" id="power-filter-title">
            Charging power
          </h3>
          <div class="options">
            {powerRanges.map(({ value, label, minKw, maxKw }) => (
              <Button
                variant="secondary"
                size="large"
                class="power-filter"
                aria-pressed="false"
                data-power-range={value}
                data-min-kw={minKw}
                data-max-kw={maxKw}
              >
                {label}
              </Button>
            ))}
          </div>
        </div>
      </div>
      <div class="footer">
        <Button variant="secondary" size="large" class="clear-filters" disabled>
          Clear filters
        </Button>
        <Button variant="primary" size="large" class="done">
          Done
        </Button>
      </div>
    </dialog>

    <aside class="charger-details" aria-labelledby="charger-details-name" hidden>
      <div class="header">
        <span class="badge">
          <Icon icon={Zap} size="sm" />
          EV charging
        </span>
        <Button variant="ghost" size="icon-only" class="close" aria-label="Close">
          <Icon icon={X} />
        </Button>
      </div>
      <h2 class="name" id="charger-details-name"></h2>
      <p class="address">
        <Icon icon={MapPin} size="sm" />
        <span class="text"></span>
      </p>
      <section class="section">
        <h3 class="title">
          <Icon icon={PlugZap} size="sm" />
          Connectors
        </h3>
        <ul class="connectors"></ul>
      </section>
      <section class="section">
        <h3 class="title">
          <Icon icon={Info} size="sm" />
          Details
        </h3>
        <ul class="details"></ul>
      </section>
      <p class="attribution">
        Charging data from
        <a href="https://openchargemap.org" target="_blank" rel="noopener">
          Open Charge Map
        </a>
      </p>
      <template class="item-template">
        <li></li>
      </template>
    </aside>

    <template class="charger-cluster-template">
      <div class="charger-cluster">
        <span class="count"></span>
      </div>
    </template>

    <template class="charger-marker-template">
      <div class="charger-marker">
        <Icon icon={Zap} filled size="sm" />
      </div>
    </template>
  </div>
  <script src="./GoogleMap.js"></script>
</ev-google-map>
