---
import Card from "@ev-maps/ui/Card.astro";
import Badge from "@ev-maps/ui/Badge.astro";
import BadgeList from "@ev-maps/ui/BadgeList.astro";
import Button from "@ev-maps/ui/Button.astro";
import Dialog from "@ev-maps/ui/Dialog.astro";
import SegmentedControl from "@ev-maps/ui/SegmentedControl.astro";
import Tooltip from "@ev-maps/ui/Tooltip.astro";
// The chargers list's facts are badges its script makes.
import "@ev-maps/ui/Badge.css";
import {
  Activity,
  Baby,
  ExternalLink,
  Coffee,
  Toilet,
  Utensils,
  MapPinned,
  Heart,
  Info,
  List,
  ZoomIn,
  MapPin,
  MapPinPlus,
  Navigation,
  PlugZap,
  X,
  Zap,
  Flag,
  Route,
} from "lucide-static";
import Icon from "@ev-maps/ui/Icon.astro";
import FilterButton from "../filter-button/FilterButton.astro";
import PlaceSearch from "../place-search/PlaceSearch.astro";
import RouteButton from "../route-button/RouteButton.astro";
import RoutePlanner from "../route-planner/RoutePlanner.astro";
import SavedPlacePin from "../saved-place-pin/SavedPlacePin.astro";
import ShortcutsDialog from "../shortcuts-dialog/ShortcutsDialog.astro";
import DistanceText from "../distance-text/DistanceText.astro";
import { translations } from "../../i18n/index.js";
import { connectorGroups as connectorGroupsFor } from "../../lib/connector-groups.js";
import "./GoogleMap.css";

interface Props {
  apiKey?: string;
  mapId?: string;
  centerLat?: number;
  centerLng?: number;
  zoom?: number;
  locatedZoom?: number;
  minChargerZoom?: number;
  // A country page's chargers, shown without loading them from the API.
  chargers?: object[];
  // Whether those are only some of the country's chargers.
  chargersTruncated?: boolean;
  chargerBounds?: { north: number; south: number; east: number; west: number };
}

const powerRanges = [
  { value: "under-50", label: "< 50 kW", minKw: 0, maxKw: 50 },
  { value: "50-150", label: "50–150 kW", minKw: 50, maxKw: 150 },
  { value: "150-300", label: "150–300 kW", minKw: 150, maxKw: 300 },
  { value: "300-plus", label: "300+ kW", minKw: 300 },
];

const {
  apiKey = "",
  mapId = "DEMO_MAP_ID",
  centerLat = 0,
  centerLng = 0,
  zoom = 12,
  locatedZoom = 14,
  minChargerZoom = 9,
  chargers,
  chargersTruncated = false,
  chargerBounds,
} = Astro.props;

const { page, values } = translations(Astro.currentLocale ?? "en");
// How near a place must be for the "nearby" filters: the Worker's
// NEARBY_METERS (packages/worker/src/amenities.js).
const NEARBY_METERS = 150;

// Kinds of places next to chargers (packages/worker/src/amenities.js).
const amenities = [
  { id: "coffee", icon: Coffee },
  { id: "toilets", icon: Toilet },
  { id: "restaurant", icon: Utensils },
  { id: "playground", icon: Baby },
];

// The data sources the details credit, in the order shown.
const OSM_COPYRIGHT = "https://www.openstreetmap.org/copyright";
const osmCredit = `${page.openStreetMapCredit.link}${page.openStreetMapCredit.after}`;
const sources = [
  {
    id: "ocm",
    href: "https://openchargemap.org",
    label: page.chargingDataSource,
    credit: `${page.openChargeMapCredit.before} Open Charge Map${page.openChargeMapCredit.after}`,
  },
  {
    id: "eipa",
    href: "https://eipa.udt.gov.pl",
    label: page.chargingDataSource,
    credit: `${page.eipaCredit.before} EIPA${page.eipaCredit.after}`,
  },
  {
    id: "irve",
    href: "https://transport.data.gouv.fr/datasets/base-nationale-des-irve-infrastructures-de-recharge-pour-vehicules-electriques",
    label: page.chargingDataSource,
    credit: `${page.irveCredit.before} ${page.irveCredit.link}${page.irveCredit.after}`,
  },
  {
    id: "osm",
    href: OSM_COPYRIGHT,
    label: page.chargingDataSource,
    credit: `${page.openStreetMapCredit.before} ${osmCredit}`,
  },
  {
    id: "osm-places",
    href: OSM_COPYRIGHT,
    label: page.nearbyPlacesSource,
    credit: `${page.openStreetMapPlacesCredit.before} ${osmCredit}`,
  },
];

// Connector types users choose between (src/lib/connector-groups.js).
const connectorGroups = connectorGroupsFor(page);

// JSON inside <script>: escape "<" so the data can't close the element.
const chargersJson = chargers && JSON.stringify(chargers).replaceAll("<", "\\u003c");
---

<ev-google-map
  data-api-key={apiKey}
  data-map-id={mapId}
  data-center-lat={centerLat}
  data-center-lng={centerLng}
  data-zoom={zoom}
  data-located-zoom={locatedZoom}
  data-min-charger-zoom={minChargerZoom}
  data-charger-bounds={chargerBounds && JSON.stringify(chargerBounds)}
  data-page-chargers-truncated={chargersTruncated ? "" : undefined}
>
  {chargersJson && <script type="application/json" class="page-chargers" set:html={chargersJson} />}
  <div class="google-map-container">
    <div class="google-map" role="region" aria-label={page.mapLabel}></div>

    <button
      type="button"
      class="map-status"
      aria-haspopup="dialog"
      aria-controls="charger-list"
      aria-labelledby="map-status-text"
      data-state={apiKey ? "idle" : "error"}
      disabled
    >
      <!-- A live region's text doesn't name the button it's in, hence aria-labelledby. -->
      <span class="text" id="map-status-text" role="status" aria-live="polite">
        {!apiKey && page.apiKeyMissing}
      </span>
      <Icon icon={List} size="sm" class="list-icon" />
      <Icon icon={ZoomIn} size="sm" class="zoom-icon" />
    </button>

    <!-- No separate clear or locate buttons here: clearing is part of the
         filter and route buttons (compact halves that appear when active),
         and Locate Me is in the top bar, next to the account menu. -->
    <!-- Right-click or long press on the map: a route from or to there. -->
    <div class="map-menu" id="map-menu" popover role="menu" aria-label={page.mapMenu}>
      <button type="button" class="map-menu-item" role="menuitem" data-end="from">
        <Icon icon={Route} size="sm" />
        {page.routeFromHere}
      </button>
      <button type="button" class="map-menu-item" role="menuitem" data-end="to">
        <Icon icon={Flag} size="sm" />
        {page.routeToHere}
      </button>
    </div>

    <div class="map-controls">
      <PlaceSearch />
      <RouteButton controls="route-planner" />
      <FilterButton controls="map-filter-panel" />
    </div>

    <!-- Dropping a pin for a suggested charger: the map moves under a pin
         fixed in its middle, until the user takes the spot or cancels. -->
    <div class="pick-location" hidden>
      <span class="pick-pin" aria-hidden="true">
        <Icon icon={MapPin} />
      </span>
      <div class="pick-bar" role="region" aria-labelledby="pick-location-hint">
        <p class="pick-hint" id="pick-location-hint">
          {page.pickLocationHint}
        </p>
        <div class="pick-actions">
          <Button variant="secondary" class="pick-cancel">
            {page.cancelPin}
          </Button>
          <Button variant="primary" class="pick-confirm">
            {page.usePinnedLocation}
          </Button>
        </div>
      </div>
    </div>

    <RoutePlanner id="route-planner" />
    <ShortcutsDialog />

    <Dialog
      class="filter-dialog"
      id="map-filter-panel"
      title={page.filters}
      titleId="filter-panel-title"
      closeLabel={page.closeFilters}
    >
      <!-- Two short, single-button groups share one row where there's room. -->
      <div class="group-row">
        <div class="group" role="group" aria-labelledby="favorites-filter-title">
          <h3 class="subtitle" id="favorites-filter-title">
            {page.favorites}
          </h3>
          <div class="options">
            <Button
              variant="secondary"
              size="large"
              class="favorites-filter"
              aria-pressed="false"
              aria-disabled="true"
              aria-describedby="favorites-filter-hint"
            >
              <Icon icon={Heart} size="sm" />
              {page.onlyFavorites}
            </Button>
          </div>
          <p class="hint" id="favorites-filter-hint">
            {page.signInForFavorites}
          </p>
        </div>
        <div class="group" role="group" aria-labelledby="availability-filter-title">
          <h3 class="subtitle" id="availability-filter-title">
            {page.availability}
          </h3>
          <div class="options">
            <Button
              variant="secondary"
              size="large"
              class="availability-filter"
              aria-pressed="false"
              aria-disabled="true"
              aria-describedby="availability-filter-hint availability-filter-about"
            >
              <Icon icon={Activity} size="sm" />
              {page.hideUnavailable}
            </Button>
          </div>
          <p class="hint" id="availability-filter-hint">
            {page.signInForAvailability}
          </p>
          <p class="hint" id="availability-filter-about">
            {page.hideUnavailableHint}
          </p>
        </div>
      </div>
      <div class="group" role="group" aria-labelledby="nearby-filter-title">
        <h3 class="subtitle" id="nearby-filter-title">
          {page.nearby}
        </h3>
        <div class="options">
          {amenities.map(({ id, icon }) => (
            <Button
              variant="secondary"
              size="large"
              class="nearby-filter"
              aria-pressed="false"
              aria-disabled="true"
              aria-describedby="nearby-filter-hint"
              data-amenity={id}
            >
              <Icon icon={icon} size="sm" />
              {values.amenities[id]}
            </Button>
          ))}
        </div>
        <p class="hint" id="nearby-filter-hint">
          {page.signInForNearby}
        </p>
        <DistanceText class="hint" template={page.nearbyFilterHint} meters={NEARBY_METERS} />
      </div>
      <div class="group" role="group" aria-labelledby="connector-filter-title">
        <h3 class="subtitle" id="connector-filter-title">
          {page.connectorType}
        </h3>
        <div class="options">
          {connectorGroups.map(({ value, label, types }) => (
            <Button
              variant="secondary"
              size="large"
              class="connector-filter"
              aria-pressed="false"
              data-connector-group={value}
              data-connector-types={types.join(",")}
            >
              {label}
            </Button>
          ))}
          <!-- Selects exactly the car's connector groups (the account
               menu's car setting); shown only once the car has some. -->
          <Button variant="secondary" size="large" class="car-filter" aria-pressed="false" hidden>
            {page.myCarChargers}
          </Button>
        </div>
      </div>
      <div class="group" role="group" aria-labelledby="power-filter-title">
        <h3 class="subtitle" id="power-filter-title">
          {page.chargingPower}
        </h3>
        <div class="options">
          {powerRanges.map(({ value, label, minKw, maxKw }) => (
            <Button
              variant="secondary"
              size="large"
              class="power-filter"
              aria-pressed="false"
              data-power-range={value}
              data-min-kw={minKw}
              data-max-kw={maxKw}
            >
              {label}
            </Button>
          ))}
        </div>
      </div>
      <!-- Where a charger's per-kWh price sits among the chargers here, by
           thirds (src/lib/priciness.js): with a level on, only chargers at
           it match, so those without a comparable price don't. -->
      <div class="group" role="group" aria-labelledby="price-filter-title">
        <h3 class="subtitle" id="price-filter-title">
          {page.price}
        </h3>
        <div class="options">
          {[1, 2, 3].map((level) => (
            <Button
              variant="secondary"
              size="large"
              class="price-filter"
              aria-pressed="false"
              aria-describedby="price-filter-hint"
              data-price-level={level}
            >
              <span class="price-scale" aria-hidden="true">
                {"$".repeat(level)}
              </span>
              {page.priceLevels[level]}
            </Button>
          ))}
        </div>
        <p class="hint" id="price-filter-hint">
          {page.priceFilterHint}
        </p>
      </div>
      <div class="group" role="group" aria-labelledby="operator-filter-title">
        <div class="group-header">
          <h3 class="subtitle" id="operator-filter-title">
            {page.operatorFilter}
          </h3>
          <Button variant="ghost" size="small" class="show-all-operators" hidden>
            {page.showAllOperators}
          </Button>
        </div>
        <p class="hint">{page.operatorFilterHint}</p>
        <p class="hint no-operators">{page.noOperators}</p>
        <!-- The operators of the chargers on the map, from the template below. -->
        <ul class="operator-options"></ul>
        <template class="operator-option-template">
          <li>
            <label class="operator-option">
              <input type="checkbox" class="operator-filter" checked />
              <span class="operator-name"></span>
              <span class="operator-count"></span>
            </label>
          </li>
        </template>
      </div>
      <Fragment slot="footer">
        <Button variant="secondary" size="large" class="clear-filters" disabled>
          {page.clearFilters}
        </Button>
        <Button variant="primary" size="large" class="done">
          {page.done}
        </Button>
        <!-- Signed in, filters are saved to the account as they change. -->
        <p class="sync-sign-in" hidden>
          {page.signInToSaveFilters}
          <Button variant="ghost" size="small" class="sync-sign-in-button">
            {page.signIn}
          </Button>
        </p>
        <p class="save-status" aria-live="polite"></p>
      </Fragment>
    </Dialog>

    <Dialog
      class="charger-list"
      id="charger-list"
      title={page.chargerList}
      titleId="charger-list-title"
      closeLabel={page.closeList}
    >
      <Fragment slot="header">
        <p class="sort-basis"></p>
        <!-- Along a route: sort the list by distance from the start, to
             the end, or off the route. -->
        <SegmentedControl
          class="sort-options"
          legend={page.sortByDistance}
          name="sort-by"
          options={["start", "end", "route"].map((by) => ({
            value: by,
            label: page.sortByOptions[by],
          }))}
          hidden
        />
      </Fragment>
      <ol class="items"></ol>
      <Fragment slot="after">
        <template class="item-template">
          <li class="item">
            <Card as="button" type="button" class="entry">
              <span class="name"></span>
              <Badge tone="success" class="distance" />
              <!-- Along a route: from the start, to the end, off the route. -->
              <span class="route-distances" hidden></span>
              <!-- Power and priciness as chips, then the address. -->
              <BadgeList as="span" class="facts" />
              <span class="address"></span>
            </Card>
          </li>
        </template>
      </Fragment>
    </Dialog>

    <aside class="charger-details" aria-labelledby="charger-details-name" hidden>
      <div class="header">
        <h2 class="name" id="charger-details-name"></h2>
        <div class="actions">
          <!-- Signed out: disabled-looking, says to sign in, and opens the
               sign-in options. -->
          <Tooltip
            class="favorite-wrapper"
            id="favorite-sign-in-hint"
            text={page.signInForFavorites}
            placement="bottom"
            align="end"
          >
            <Button
              variant="ghost"
              size="icon-only"
              class="favorite-button"
              aria-label={page.favorite}
              aria-pressed="false"
              aria-disabled="true"
              aria-describedby="favorite-sign-in-hint"
            >
              <Icon icon={Heart} />
            </Button>
          </Tooltip>
          <Button variant="ghost" size="icon-only" class="close" aria-label={page.close}>
            <Icon icon={X} />
          </Button>
        </div>
      </div>
      <!-- The address, as a link to the charger in the maps app chosen in the
           account menu (Google Maps by default), in a new tab; "Open map"
           without an address. -->
      <a class="address" target="_blank" rel="noopener">
        <Icon icon={MapPin} size="sm" />
        <span class="text" data-no-address={page.openInMaps}></span>
        <Icon icon={ExternalLink} size="sm" class="external" />
      </a>
      <!-- Along a route: from the start, to the end, off the route. -->
      <p class="route-distances" hidden></p>
      <div class="directions">
        <!-- Plans a route here, in the route planner: from where the user is,
             if they already allow it, else they choose where from. -->
        <Button variant="primary" class="navigate" aria-haspopup="dialog">
          <Icon icon={Navigation} size="sm" />
          <span class="label">{page.navigate}</span>
        </Button>
        <!-- Adds or removes the charger as a stop along the route, shown only
             while there's one. -->
        <Button
          variant="secondary"
          class="add-to-route"
          hidden
          aria-pressed="false"
          data-add-label={page.addRouteStop}
          data-remove-label={page.removeRouteStop}
        >
          <Icon icon={MapPinPlus} size="sm" />
          <span class="label">{page.addRouteStop}</span>
        </Button>
      </div>
      <section class="section connectors-section">
        <h3 class="title">
          <Icon icon={PlugZap} size="sm" />
          {page.connectors}
        </h3>
        <!-- Each connector green when a point is free, red when none is
             (live availability, below). -->
        <ul class="connectors"></ul>
        <div class="availability-status" hidden>
          <p class="free"></p>
          <p class="out-of-service"></p>
          <p class="updated"></p>
          <p class="sign-in-needed" hidden>
            {page.signInForAvailability}
          </p>
          <Button variant="secondary" size="small" class="sign-in-button" hidden>
            {page.signIn}
          </Button>
        </div>
      </section>
      <section class="section">
        <h3 class="title">
          <Icon icon={Info} size="sm" />
          {page.details}
        </h3>
        <ul class="details"></ul>
      </section>
      <section class="section nearby" hidden>
        <h3 class="title">
          <Icon icon={MapPinned} size="sm" />
          {page.nearby}
        </h3>
        <!-- A pill per kind, with the filter's icon; the script shows the
             charger's. -->
        <BadgeList class="nearby-places">
          {amenities.map(({ id, icon }) => (
            <li data-amenity={id} hidden>
              <Badge size="md">
                <Icon icon={icon} size="sm" />
                {values.amenities[id]}
              </Badge>
            </li>
          ))}
        </BadgeList>
      </section>
      <!-- Where the charger's data comes from: a link per source shown (the
           script picks them), each with its full credit as its title. -->
      <p class="sources">
        {sources.map(({ id, href, label, credit }) => (
          <a
            class="attribution"
            data-source={id}
            href={href}
            title={credit}
            target="_blank"
            rel="noopener"
            hidden
          >
            {label}
          </a>
        ))}
        <span class="attribution" data-source="community" hidden>
          {page.communityCredit}
        </span>
      </p>
      <template class="item-template">
        <li></li>
      </template>
      <template class="connector-card-template">
        <li class="connector-card">
          <!-- Its text, ID and alignment are set by the script. -->
          <Tooltip class="connector-info-wrapper">
            <button type="button" class="connector-info">
              <Icon icon={Info} size="sm" />
            </button>
          </Tooltip>
          <!-- Standard EV connector plug diagrams; the matching one is unhidden. -->
          <span class="connector-diagram" data-diagram="ccs" hidden>
            <svg class="plug-svg" viewBox="0 0 36 44" aria-hidden="true">
              <path
                class="plug-shell"
                d="M11 3 H25 A8 8 0 0 1 31 16 L28 24 H8 L5 16 A8 8 0 0 1 11 3 Z"
              />
              <circle class="plug-pin" cx="14" cy="8.5" r="1.4" />
              <circle class="plug-pin" cx="22" cy="8.5" r="1.4" />
              <circle class="plug-pin" cx="11" cy="14" r="1.7" />
              <circle class="plug-pin" cx="18" cy="14" r="1.7" />
              <circle class="plug-pin" cx="25" cy="14" r="1.7" />
              <circle class="plug-pin" cx="14.5" cy="19.5" r="1.7" />
              <circle class="plug-pin" cx="21.5" cy="19.5" r="1.7" />
              <rect class="plug-shell" x="6" y="27" width="24" height="14" rx="7" />
              <circle class="plug-pin" cx="13" cy="34" r="2.8" />
              <circle class="plug-pin" cx="23" cy="34" r="2.8" />
            </svg>
          </span>
          <span class="connector-diagram" data-diagram="type2" hidden>
            <svg class="plug-svg" viewBox="0 0 36 36" aria-hidden="true">
              <path
                class="plug-shell"
                d="M10 4 H26 A12 12 0 0 1 32 22 L28 31 H8 L4 22 A12 12 0 0 1 10 4 Z"
              />
              <circle class="plug-pin" cx="13.5" cy="11" r="1.6" />
              <circle class="plug-pin" cx="22.5" cy="11" r="1.6" />
              <circle class="plug-pin" cx="10" cy="18" r="2" />
              <circle class="plug-pin" cx="18" cy="18" r="2" />
              <circle class="plug-pin" cx="26" cy="18" r="2" />
              <circle class="plug-pin" cx="14" cy="25" r="2" />
              <circle class="plug-pin" cx="22" cy="25" r="2" />
            </svg>
          </span>
          <span class="connector-diagram" data-diagram="chademo" hidden>
            <svg class="plug-svg" viewBox="0 0 36 36" aria-hidden="true">
              <circle class="plug-shell" cx="18" cy="18" r="14" />
              <circle class="plug-pin" cx="11" cy="18" r="3.2" />
              <circle class="plug-pin" cx="25" cy="18" r="3.2" />
              <circle class="plug-pin" cx="18" cy="10.5" r="1.8" />
              <circle class="plug-pin" cx="18" cy="25.5" r="1.8" />
            </svg>
          </span>
          <span class="connector-diagram" data-diagram="tesla" hidden>
            <svg class="plug-svg" viewBox="0 0 36 36" aria-hidden="true">
              <path class="plug-shell" d="M8 14 A11 11 0 0 1 28 14 L26 28 A6 6 0 0 1 10 28 Z" />
              <circle class="plug-pin" cx="13.5" cy="15" r="2.7" />
              <circle class="plug-pin" cx="22.5" cy="15" r="2.7" />
              <circle class="plug-pin" cx="18" cy="22.5" r="1.9" />
              <circle class="plug-pin" cx="14" cy="26.5" r="1.3" />
              <circle class="plug-pin" cx="22" cy="26.5" r="1.3" />
            </svg>
          </span>
          <span class="connector-diagram" data-diagram="type1" hidden>
            <svg class="plug-svg" viewBox="0 0 36 36" aria-hidden="true">
              <circle class="plug-shell" cx="18" cy="18" r="14" />
              <circle class="plug-pin" cx="13.5" cy="13" r="2.1" />
              <circle class="plug-pin" cx="22.5" cy="13" r="2.1" />
              <circle class="plug-pin" cx="12" cy="20.5" r="1.6" />
              <circle class="plug-pin" cx="24" cy="20.5" r="1.6" />
              <circle class="plug-pin" cx="18" cy="25" r="2.1" />
            </svg>
          </span>
          <span class="connector-diagram" data-diagram="household" hidden>
            <svg class="plug-svg" viewBox="0 0 36 36" aria-hidden="true">
              <circle class="plug-shell" cx="18" cy="18" r="14" />
              <circle class="plug-pin" cx="13" cy="18" r="2.4" />
              <circle class="plug-pin" cx="23" cy="18" r="2.4" />
            </svg>
          </span>
          <span class="connector-meta">
            <span class="connector-power"></span>
            <span class="connector-qty"></span>
          </span>
          <span class="connector-points" aria-hidden="true"></span>
          <span class="connector-no-status"></span>
        </li>
      </template>
      <template class="connector-point-template">
        <span class="connector-point"></span>
      </template>
    </aside>

    <template class="route-visual-template">
      <span class="route-visual" role="img">
        <span class="route-visual-track" aria-hidden="true">
          <span class="route-visual-node start"></span>
          <span class="route-visual-road">
            <span class="route-visual-segment before"></span>
            <span class="route-visual-bend">
              <svg class="route-visual-bend-svg" viewBox="0 0 112 36" preserveAspectRatio="none">
                <line class="route-visual-bypass" x1="14" y1="31" x2="98" y2="31" />
                <line class="route-visual-bypass" x1="4" y1="35" x2="108" y2="35" />
                <path
                  class="route-visual-curve"
                  d="M 0,33 C 16,33 18,7 34,7 L 78,7 C 94,7 96,33 112,33"
                />
              </svg>
              <span class="route-visual-pin"></span>
              <span class="route-visual-detour"></span>
            </span>
            <span class="route-visual-segment after"></span>
          </span>
          <span class="route-visual-node end"></span>
        </span>
        <span class="route-visual-legend" aria-hidden="true">
          <span class="route-visual-distance start"></span>
          <span class="route-visual-distance end"></span>
        </span>
      </span>
    </template>

    <template class="charger-cluster-template">
      <div class="charger-cluster">
        <span class="count"></span>
      </div>
    </template>

    <!-- A saved place's pin (saved-places-layer.js): its icon shows. -->
    <template class="saved-place-marker-template">
      <SavedPlacePin class="saved-place-marker" />
    </template>

    <template class="charger-marker-template">
      <!-- A favorite's pin is pink, with a heart instead of the bolt. -->
      <div class="charger-marker">
        <span class="marker-icon bolt">
          <Icon icon={Zap} filled size="sm" />
        </span>
        <span class="marker-icon heart">
          <Icon icon={Heart} filled size="sm" />
        </span>
      </div>
    </template>
  </div>
  <script src="./GoogleMap.js"></script>
</ev-google-map>
