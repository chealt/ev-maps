---
import Button from "@ev-maps/ui/Button.astro";
import {
  Activity,
  Baby,
  Coffee,
  Toilet,
  Utensils,
  MapPinned,
  FilterX,
  Heart,
  Info,
  List,
  ZoomIn,
  MapPin,
  Navigation,
  PlugZap,
  RouteOff,
  X,
  Zap,
} from "lucide-static";
import Icon from "@ev-maps/ui/Icon.astro";
import LocateButton from "../locate-button/LocateButton.astro";
import FilterButton from "../filter-button/FilterButton.astro";
import RouteButton from "../route-button/RouteButton.astro";
import RoutePlanner from "../route-planner/RoutePlanner.astro";
import ShortcutsDialog from "../shortcuts-dialog/ShortcutsDialog.astro";
import { translations } from "../../i18n/index.js";
import "./GoogleMap.css";

interface Props {
  apiKey?: string;
  mapId?: string;
  centerLat?: number;
  centerLng?: number;
  zoom?: number;
  locatedZoom?: number;
  autoLocate?: boolean;
  minChargerZoom?: number;
  // A country page's chargers, shown without loading them from the API.
  chargers?: object[];
  // Whether those are only some of the country's chargers.
  chargersTruncated?: boolean;
  chargerBounds?: { north: number; south: number; east: number; west: number };
}

const powerRanges = [
  { value: "under-50", label: "< 50 kW", minKw: 0, maxKw: 50 },
  { value: "50-150", label: "50–150 kW", minKw: 50, maxKw: 150 },
  { value: "150-300", label: "150–300 kW", minKw: 150, maxKw: 300 },
  { value: "300-plus", label: "300+ kW", minKw: 300 },
];

const {
  apiKey = "",
  mapId = "DEMO_MAP_ID",
  centerLat = 0,
  centerLng = 0,
  zoom = 12,
  locatedZoom = 14,
  autoLocate = true,
  minChargerZoom = 9,
  chargers,
  chargersTruncated = false,
  chargerBounds,
} = Astro.props;

const { page, values } = translations(Astro.currentLocale ?? "en");

// Kinds of places next to chargers (packages/worker/src/amenities.js).
const amenities = [
  { id: "coffee", icon: Coffee },
  { id: "toilets", icon: Toilet },
  { id: "restaurant", icon: Utensils },
  { id: "playground", icon: Baby },
];

// Connector types users choose between, and the connector IDs each covers
// (packages/worker/src/charger-values.js).
const connectorGroups = [
  { value: "ccs", label: "CCS", types: ["ccs2", "ccs1"] },
  { value: "chademo", label: "CHAdeMO", types: ["chademo"] },
  {
    value: "type2",
    label: page.connectorType2,
    types: ["type2", "type2-socket", "type2-tethered"],
  },
  { value: "type1", label: page.connectorType1, types: ["type1"] },
  {
    value: "tesla",
    label: "Tesla / NACS",
    types: ["nacs", "tesla-supercharger", "tesla-destination", "tesla-model-sx"],
  },
  { value: "household", label: page.connectorHousehold, types: ["schuko", "cee-7-5", "europlug"] },
];

// JSON inside <script>: escape "<" so the data can't close the element.
const chargersJson = chargers && JSON.stringify(chargers).replaceAll("<", "\\u003c");
---

<ev-google-map
  data-api-key={apiKey}
  data-map-id={mapId}
  data-center-lat={centerLat}
  data-center-lng={centerLng}
  data-zoom={zoom}
  data-located-zoom={locatedZoom}
  data-min-charger-zoom={minChargerZoom}
  data-charger-bounds={chargerBounds && JSON.stringify(chargerBounds)}
  data-page-chargers-truncated={chargersTruncated ? "" : undefined}
>
  {chargersJson && <script type="application/json" class="page-chargers" set:html={chargersJson} />}
  <div class="google-map-container">
    <div class="google-map" role="region" aria-label={page.mapLabel}></div>

    <button
      type="button"
      class="map-status"
      aria-haspopup="dialog"
      aria-controls="charger-list"
      aria-labelledby="map-status-text"
      data-state={apiKey ? "idle" : "error"}
      disabled
    >
      <!-- A live region's text doesn't name the button it's in, hence aria-labelledby. -->
      <span class="text" id="map-status-text" role="status" aria-live="polite">
        {!apiKey && page.apiKeyMissing}
      </span>
      <Icon icon={List} size="sm" class="list-icon" />
      <Icon icon={ZoomIn} size="sm" class="zoom-icon" />
    </button>

    <div class="map-controls">
      <LocateButton autoLocate={autoLocate} />
      <RouteButton controls="route-planner" />
      <FilterButton controls="map-filter-panel" />
      <Button variant="secondary" class="clear-filters" aria-keyshortcuts="c" hidden>
        <Icon icon={FilterX} />
        <span class="label">{page.clearFilters}</span>
      </Button>
      <Button variant="secondary" class="clear-route" hidden>
        <Icon icon={RouteOff} />
        <span class="label">{page.clearRoute}</span>
      </Button>
    </div>

    <RoutePlanner id="route-planner" />
    <ShortcutsDialog />

    <dialog
      class="fullscreen-dialog filter-dialog"
      id="map-filter-panel"
      aria-labelledby="filter-panel-title"
    >
      <div class="header">
        <h2 class="title" id="filter-panel-title">
          {page.filters}
        </h2>
        <Button variant="ghost" size="icon-only" class="close" aria-label={page.closeFilters}>
          <Icon icon={X} />
        </Button>
      </div>
      <div class="body">
        <div class="group" role="group" aria-labelledby="favorites-filter-title">
          <h3 class="subtitle" id="favorites-filter-title">
            {page.favorites}
          </h3>
          <div class="options">
            <Button
              variant="secondary"
              size="large"
              class="favorites-filter"
              aria-pressed="false"
              aria-disabled="true"
              aria-describedby="favorites-filter-hint"
            >
              <Icon icon={Heart} size="sm" />
              {page.onlyFavorites}
            </Button>
          </div>
          <p class="hint" id="favorites-filter-hint">
            {page.signInForFavorites}
          </p>
        </div>
        <div class="group" role="group" aria-labelledby="nearby-filter-title">
          <h3 class="subtitle" id="nearby-filter-title">
            {page.nearby}
          </h3>
          <div class="options">
            {amenities.map(({ id, icon }) => (
              <Button
                variant="secondary"
                size="large"
                class="nearby-filter"
                aria-pressed="false"
                aria-disabled="true"
                aria-describedby="nearby-filter-hint"
                data-amenity={id}
              >
                <Icon icon={icon} size="sm" />
                {values.amenities[id]}
              </Button>
            ))}
          </div>
          <p class="hint" id="nearby-filter-hint">
            {page.signInForNearby}
          </p>
          <p class="hint">{page.nearbyFilterHint}</p>
        </div>
        <div class="group" role="group" aria-labelledby="connector-filter-title">
          <h3 class="subtitle" id="connector-filter-title">
            {page.connectorType}
          </h3>
          <div class="options">
            {connectorGroups.map(({ value, label, types }) => (
              <Button
                variant="secondary"
                size="large"
                class="connector-filter"
                aria-pressed="false"
                data-connector-group={value}
                data-connector-types={types.join(",")}
              >
                {label}
              </Button>
            ))}
          </div>
        </div>
        <div class="group" role="group" aria-labelledby="power-filter-title">
          <h3 class="subtitle" id="power-filter-title">
            {page.chargingPower}
          </h3>
          <div class="options">
            {powerRanges.map(({ value, label, minKw, maxKw }) => (
              <Button
                variant="secondary"
                size="large"
                class="power-filter"
                aria-pressed="false"
                data-power-range={value}
                data-min-kw={minKw}
                data-max-kw={maxKw}
              >
                {label}
              </Button>
            ))}
          </div>
        </div>
        <div class="group" role="group" aria-labelledby="operator-filter-title">
          <div class="group-header">
            <h3 class="subtitle" id="operator-filter-title">
              {page.operatorFilter}
            </h3>
            <Button variant="ghost" size="small" class="show-all-operators" hidden>
              {page.showAllOperators}
            </Button>
          </div>
          <p class="hint">{page.operatorFilterHint}</p>
          <p class="hint no-operators">{page.noOperators}</p>
          <!-- The operators of the chargers on the map, from the template below. -->
          <ul class="operator-options"></ul>
          <template class="operator-option-template">
            <li>
              <label class="operator-option">
                <input type="checkbox" class="operator-filter" checked />
                <span class="operator-name"></span>
                <span class="operator-count"></span>
              </label>
            </li>
          </template>
        </div>
      </div>
      <div class="footer">
        <Button variant="secondary" size="large" class="clear-filters" disabled>
          {page.clearFilters}
        </Button>
        <Button variant="primary" size="large" class="done">
          {page.done}
        </Button>
        <!-- Signed in, filters are saved to the account as they change. -->
        <p class="sync-sign-in" hidden>
          {page.signInToSaveFilters}
          <Button variant="ghost" size="small" class="sync-sign-in-button">
            {page.signIn}
          </Button>
        </p>
        <p class="save-status" aria-live="polite"></p>
      </div>
    </dialog>

    <dialog
      class="fullscreen-dialog charger-list"
      id="charger-list"
      aria-labelledby="charger-list-title"
    >
      <div class="header">
        <div>
          <h2 class="title" id="charger-list-title">
            {page.chargerList}
          </h2>
          <p class="sort-basis"></p>
        </div>
        <Button variant="ghost" size="icon-only" class="close" aria-label={page.closeList}>
          <Icon icon={X} />
        </Button>
      </div>
      <div class="body">
        <ol class="items"></ol>
      </div>
      <template class="item-template">
        <li class="item">
          <button type="button" class="entry">
            <span class="name"></span>
            <span class="distance"></span>
            <span class="meta"></span>
          </button>
        </li>
      </template>
    </dialog>

    <aside class="charger-details" aria-labelledby="charger-details-name" hidden>
      <div class="header">
        <h2 class="name" id="charger-details-name"></h2>
        <div class="actions">
          <!-- Signed out: disabled-looking, says to sign in, and opens the
               sign-in options. -->
          <span class="favorite-wrapper">
            <Button
              variant="ghost"
              size="icon-only"
              class="favorite-button"
              aria-label={page.favorite}
              aria-pressed="false"
              aria-disabled="true"
              aria-describedby="favorite-sign-in-hint"
            >
              <Icon icon={Heart} />
            </Button>
            <span class="tooltip" id="favorite-sign-in-hint" role="tooltip">
              {page.signInForFavorites}
            </span>
          </span>
          <Button variant="ghost" size="icon-only" class="close" aria-label={page.close}>
            <Icon icon={X} />
          </Button>
        </div>
      </div>
      <p class="address">
        <Icon icon={MapPin} size="sm" />
        <span class="text"></span>
      </p>
      <!-- Directions in Google Maps: with no "from", it starts where the user
           is, if they allow it. A link, styled like the buttons. -->
      <a
        class="button primary medium navigate"
        target="_blank"
        rel="noopener"
        aria-describedby="navigate-hint"
      >
        <Icon icon={Navigation} size="sm" />
        {page.navigate}
      </a>
      <span class="visually-hidden" id="navigate-hint">
        {page.navigateHint}
      </span>
      <section class="section availability" hidden>
        <h3 class="title">
          <Icon icon={Activity} size="sm" />
          {page.availability}
        </h3>
        <p class="free"></p>
        <p class="out-of-service"></p>
        <p class="updated"></p>
        <p class="sign-in-needed" hidden>
          {page.signInForAvailability}
        </p>
        <Button variant="secondary" size="small" class="sign-in-button" hidden>
          {page.signIn}
        </Button>
      </section>
      <section class="section">
        <h3 class="title">
          <Icon icon={PlugZap} size="sm" />
          {page.connectors}
        </h3>
        <ul class="connectors"></ul>
      </section>
      <section class="section">
        <h3 class="title">
          <Icon icon={Info} size="sm" />
          {page.details}
        </h3>
        <ul class="details"></ul>
      </section>
      <section class="section nearby" hidden>
        <h3 class="title">
          <Icon icon={MapPinned} size="sm" />
          {page.nearby}
        </h3>
        <ul class="nearby-places"></ul>
      </section>
      <p class="attribution" data-source="ocm" hidden>
        {page.openChargeMapCredit.before}{" "}
        <a href="https://openchargemap.org" target="_blank" rel="noopener">
          Open Charge Map
        </a>
        {page.openChargeMapCredit.after}
      </p>
      <p class="attribution" data-source="eipa" hidden>
        {page.eipaCredit.before}{" "}
        <a href="https://eipa.udt.gov.pl" target="_blank" rel="noopener">
          EIPA
        </a>
        {page.eipaCredit.after}
      </p>
      <p class="attribution" data-source="irve" hidden>
        {page.irveCredit.before}{" "}
        <a
          href="https://transport.data.gouv.fr/datasets/base-nationale-des-irve-infrastructures-de-recharge-pour-vehicules-electriques"
          target="_blank"
          rel="noopener"
        >
          {page.irveCredit.link}
        </a>
        {page.irveCredit.after}
      </p>
      <p class="attribution" data-source="osm" hidden>
        {page.openStreetMapCredit.before}{" "}
        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">
          {page.openStreetMapCredit.link}
        </a>
        {page.openStreetMapCredit.after}
      </p>
      <p class="attribution" data-source="osm-places" hidden>
        {page.openStreetMapPlacesCredit.before}{" "}
        <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">
          {page.openStreetMapCredit.link}
        </a>
        {page.openStreetMapCredit.after}
      </p>
      <template class="item-template">
        <li></li>
      </template>
    </aside>

    <template class="charger-cluster-template">
      <div class="charger-cluster">
        <span class="count"></span>
      </div>
    </template>

    <template class="charger-marker-template">
      <!-- A favorite's pin is pink, with a heart instead of the bolt. -->
      <div class="charger-marker">
        <span class="marker-icon bolt">
          <Icon icon={Zap} filled size="sm" />
        </span>
        <span class="marker-icon heart">
          <Icon icon={Heart} filled size="sm" />
        </span>
      </div>
    </template>
  </div>
  <script src="./GoogleMap.js"></script>
</ev-google-map>
