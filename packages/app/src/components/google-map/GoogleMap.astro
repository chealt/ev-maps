---
interface Props {
  apiKey?: string;
  centerLat?: number;
  centerLng?: number;
  zoom?: number;
  showEvChargers?: boolean;
}

const { 
  apiKey = '',
  centerLat = 0,
  centerLng = 0,
  zoom = 12,
  showEvChargers = true
} = Astro.props;

import LocateButton from '../locate-button/LocateButton.astro';
import FilterButton from '../filter-button/FilterButton.astro';
import './GoogleMap.css';
---

<ev-google-map data-api-key={apiKey} data-center-lat={centerLat} data-center-lng={centerLng} data-zoom={zoom} data-show-ev-chargers={showEvChargers}>
  <div class="google-map-container">
    <div class="google-map" id="map"></div>
    <div class="map-controls">
      <LocateButton />
      <FilterButton />
    </div>
    <div class="map-status"></div>
  </div>
  <script src="/src/components/google-map/GoogleMap.js"></script>
</ev-google-map>
