---
import { Monitor, Moon, Sun } from "lucide-static";
import SegmentedControl from "@ev-maps/ui/SegmentedControl.astro";
import { translations } from "../../i18n/index.js";
import "../maps-app-picker/preference-picker.css";

const { page } = translations(Astro.currentLocale ?? "en");
const options = [
  { value: "system", label: page.themes.system, icon: Monitor },
  { value: "light", label: page.themes.light, icon: Sun },
  { value: "dark", label: page.themes.dark, icon: Moon },
];
---

<ev-theme-picker>
  <SegmentedControl
    class="theme-picker preference-picker"
    legend={page.theme}
    name="theme"
    options={options}
    value="system"
  />
  <script src="./ThemePicker.js"></script>
</ev-theme-picker>
