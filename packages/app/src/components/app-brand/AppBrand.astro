---
import { Zap } from "lucide-static";
import Icon from "../icon/Icon.astro";
import "./AppBrand.css";

interface Props {
  subtitle: string;
}

const { subtitle } = Astro.props;
---

<!-- The app's name, visible: Google's OAuth verification checks the home
     page shows the same name as the consent screen. -->
<hgroup class="app-brand">
  <span class="mark">
    <Icon icon={Zap} filled />
  </span>
  <h1 class="name">EV Maps</h1>
  <p class="visually-hidden">{subtitle}</p>
</hgroup>
