---
import { translations } from "../../i18n/index.js";
import "./AdminReports.css";

const { page } = translations(Astro.currentLocale ?? "en");
---

<!-- CI's Playwright reports (GET /api/admin/test-reports), the latest first;
     each opens from R2 through the Worker, for admins only. -->
<ev-admin-reports>
  <section aria-labelledby="admin-reports-title">
    <h2 class="section-title" id="admin-reports-title">
      {page.adminReports}
    </h2>
    <!-- Filled in with the branches that have reports; "main" until then. -->
    <label class="branch-filter">
      {page.adminBranchFilter}
      <select class="branch-select">
        <option value="">{page.adminAllBranches}</option>
        <option value="main" selected>
          main
        </option>
      </select>
    </label>
    <p class="summary"></p>
    <div class="table-wrapper">
      <table class="reports">
        <thead>
          <tr>
            <th scope="col">{page.adminWhenColumn}</th>
            <th scope="col">{page.adminResultColumn}</th>
            <th scope="col">{page.adminBranchColumn}</th>
            <th scope="col">{page.adminCommitColumn}</th>
            <th scope="col" class="number">
              {page.adminDurationColumn}
            </th>
            <th scope="col">
              <span class="visually-hidden">{page.adminReportColumn}</span>
            </th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <nav class="pager" aria-label={page.adminPages} hidden>
      <button type="button" class="previous">
        {page.adminPreviousPage}
      </button>
      <span class="page-of"></span>
      <button type="button" class="next">
        {page.adminNextPage}
      </button>
    </nav>
  </section>

  <template class="report-template">
    <tr>
      <td class="when"></td>
      <td class="result">
        <span class="status"></span>
        <span class="counts"></span>
      </td>
      <td class="branch">
        <span class="branch-name"></span>
        <a class="pull-request" target="_blank" rel="noopener" hidden></a>
      </td>
      <td>
        <a class="commit" target="_blank" rel="noopener"></a>
      </td>
      <td class="duration number"></td>
      <td>
        <a class="open-report" target="_blank" rel="noopener">
          {page.adminOpenReport}
        </a>
      </td>
    </tr>
  </template>
  <script src="./AdminReports.js"></script>
</ev-admin-reports>
