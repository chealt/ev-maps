---
import { SlidersHorizontal } from "lucide-static";
import IconButton from "../icon-button/IconButton.astro";

interface Props {
  controls?: string;
}

const { controls } = Astro.props;
---

<ev-filter-button>
  <IconButton
    icon={SlidersHorizontal}
    label="Filters"
    variant="secondary"
    class="filter-button"
    aria-expanded="false"
    aria-controls={controls}
  />
  <script src="./FilterButton.js"></script>
</ev-filter-button>
