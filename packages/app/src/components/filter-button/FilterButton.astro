---
import Badge from "@ev-maps/ui/Badge.astro";
import Button from "@ev-maps/ui/Button.astro";
import { SlidersHorizontal, X } from "lucide-static";
import Icon from "@ev-maps/ui/Icon.astro";
import { translations } from "../../i18n/index.js";
import "./FilterButton.css";

interface Props {
  controls?: string;
}

const { controls } = Astro.props;
const { page } = translations(Astro.currentLocale ?? "en");
---

<!-- The clear is part of what it clears: with filters on, a compact clear
     half appears attached to the filter button, instead of a separate button
     taking map space. -->
<ev-filter-button>
  <span class="split">
    <Button
      variant="secondary"
      class="filter-button"
      aria-expanded="false"
      aria-controls={controls}
      aria-describedby="active-filter-count"
      aria-keyshortcuts="f"
    >
      <span class="icon-wrapper">
        <Icon icon={SlidersHorizontal} />
        <!-- How many filters are on; screen readers get the description below. -->
        <Badge tone="accent" class="filter-count" aria-hidden="true" hidden />
      </span>
      <span class="label">{page.filters}</span>
    </Button>
    <Button
      variant="secondary"
      size="icon-only"
      class="clear-filters"
      aria-label={page.clearFilters}
      aria-keyshortcuts="c"
      hidden
    >
      <Icon icon={X} />
    </Button>
  </span>
  <span class="visually-hidden" id="active-filter-count"></span>
  <script src="./FilterButton.js"></script>
</ev-filter-button>
