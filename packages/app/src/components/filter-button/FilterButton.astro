---
import Button from "../button/Button.astro";
import Icon from "../icon/Icon.astro";

interface Props {
  controls?: string;
}

const { controls } = Astro.props;
---

<ev-filter-button>
  <Button variant="secondary" class="filter-button" aria-expanded="false" aria-controls={controls}>
    <Icon name="sliders" />
    <span class="button__label">Filters</span>
  </Button>
  <script src="./FilterButton.js"></script>
</ev-filter-button>
