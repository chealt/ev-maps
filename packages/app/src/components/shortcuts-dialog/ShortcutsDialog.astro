---
import { Keyboard } from "lucide-static";
import Card from "@ev-maps/ui/Card.astro";
import Dialog from "@ev-maps/ui/Dialog.astro";
import Icon from "@ev-maps/ui/Icon.astro";
import { translations } from "../../i18n/index.js";
import "./ShortcutsDialog.css";

const { page } = translations(Astro.currentLocale ?? "en");

// The keys (GoogleMap.js and ShortcutsDialog.js handle them), by what they
// control; each with its description's message.
const groups = [
  {
    id: "map",
    keys: [
      ["s", "search"],
      ["l", "locate"],
      ["Esc", "closeDialogs"],
      ["?", "help"],
    ],
  },
  {
    id: "route",
    keys: [
      ["r", "route"],
      ["x", "clearRoute"],
    ],
  },
  {
    id: "filters",
    keys: [
      ["f", "filters"],
      ["c", "clearFilters"],
    ],
  },
  {
    id: "account",
    keys: [
      ["a", "accountMenu"],
      ["h", "favorites"],
      ["n", "suggestCharger"],
      ["p", "savedPlaces"],
    ],
  },
];
---

<ev-shortcuts>
  <Dialog
    class="shortcuts-dialog"
    title={page.shortcuts.title}
    titleId="shortcuts-title"
    closeLabel={page.close}
  >
    <Fragment slot="title">
      <Icon icon={Keyboard} size="sm" />
      {page.shortcuts.title}
    </Fragment>
    <div class="shortcut-groups">
      {groups.map(({ id, keys }) => (
        <Card as="section" class="shortcut-group" aria-labelledby={`shortcuts-${id}`}>
          <h3 class="group-title" id={`shortcuts-${id}`}>
            {page.shortcuts.groups[id]}
          </h3>
          <ul class="shortcut-list">
            {keys.map(([key, label]) => (
              <li>
                <kbd>{key}</kbd>
                <span>{page.shortcuts[label]}</span>
              </li>
            ))}
          </ul>
        </Card>
      ))}
    </div>
  </Dialog>
  <script src="./ShortcutsDialog.js"></script>
</ev-shortcuts>
