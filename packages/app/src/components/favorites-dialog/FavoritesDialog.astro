---
import { Heart } from "lucide-static";
import Button from "@ev-maps/ui/Button.astro";
import Dialog from "@ev-maps/ui/Dialog.astro";
import Icon from "@ev-maps/ui/Icon.astro";
import { translations } from "../../i18n/index.js";
import "./FavoritesDialog.css";

const { page } = translations(Astro.currentLocale ?? "en");
---

<!-- The signed-in user's favorite chargers, nearest to the map's center
     first; opened from the account menu, which morphs into it. -->
<ev-favorites-dialog>
  <Dialog
    class="favorites-dialog"
    title={page.favorites}
    titleId="favorites-title"
    closeLabel={page.closeFavorites}
  >
    <Fragment slot="header">
      <p class="sort-basis">{page.nearestToMapCenter}</p>
    </Fragment>
    <p class="empty">
      <Icon icon={Heart} size="sm" />
      {page.noFavorites}
    </p>
    <ol class="items"></ol>
    <Fragment slot="after">
      <template class="item-template">
        <li class="item">
          <button type="button" class="entry">
            <span class="name"></span>
            <span class="distance"></span>
            <span class="meta"></span>
          </button>
          <Button variant="ghost" size="icon-only" class="remove">
            <Icon icon={Heart} />
          </Button>
        </li>
      </template>
    </Fragment>
  </Dialog>
  <script src="./FavoritesDialog.js"></script>
</ev-favorites-dialog>
