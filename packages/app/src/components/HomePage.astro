---
import GoogleMap from "./google-map/GoogleMap.astro";
import { appConfig } from "../config/app.config.js";

interface Props {
  title?: string;
}

const { title = "EV Maps" } = Astro.props;
const { googleMaps, evChargers } = appConfig;
---

<main>
  <h1 class="visually-hidden">{title}</h1>

  <GoogleMap
    apiKey={googleMaps.apiKey}
    mapId={googleMaps.mapId}
    clientId={googleMaps.clientId}
    centerLat={googleMaps.defaultCenter.lat}
    centerLng={googleMaps.defaultCenter.lng}
    zoom={googleMaps.defaultZoom}
    locatedZoom={googleMaps.locatedZoom}
    autoLocate={googleMaps.autoLocate}
    searchRadius={evChargers.searchRadiusMeters}
    showEvChargers={evChargers.enabled}
  />
</main>
