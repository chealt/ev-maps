---
import FavoritesDialog from "./favorites-dialog/FavoritesDialog.astro";
import GoogleMap from "./google-map/GoogleMap.astro";
import ReportChangeDialog from "./report-change-dialog/ReportChangeDialog.astro";
import SuggestChargerDialog from "./suggest-charger-dialog/SuggestChargerDialog.astro";
import UserMenu from "./user-menu/UserMenu.astro";
import { appConfig } from "../config/app.config.js";
import { translations } from "../i18n/index.js";
import "./HomePage.css";

interface Props {
  chargers?: object[];
  truncated?: boolean;
  chargerBounds?: { north: number; south: number; east: number; west: number };
}

const { page } = translations(Astro.currentLocale ?? "en");
const { chargers, truncated, chargerBounds } = Astro.props;
const { googleMaps, evChargers } = appConfig;
---

<main class="home-page">
  <UserMenu subtitle={page.subtitle} autoLocate={googleMaps.autoLocate} />

  <GoogleMap
    apiKey={googleMaps.apiKey}
    mapId={googleMaps.mapId}
    centerLat={googleMaps.defaultCenter.lat}
    centerLng={googleMaps.defaultCenter.lng}
    zoom={googleMaps.defaultZoom}
    locatedZoom={googleMaps.locatedZoom}
    minChargerZoom={evChargers.minZoom}
    chargers={chargers}
    chargersTruncated={truncated}
    chargerBounds={chargerBounds}
  />
  <FavoritesDialog />
  <SuggestChargerDialog apiKey={googleMaps.apiKey} />
  <ReportChangeDialog />
</main>
