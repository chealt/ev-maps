---
import Map from './map/Map.astro';

interface Props {
  title?: string;
  subtitle?: string;
}

const { title = 'EV Maps', subtitle = 'Find electric vehicle charging stations near you' } = Astro.props;
---

<main class="container">
  <h1>{title}</h1>
  <p class="subtitle">{subtitle}</p>
  
  <Map apiKey={import.meta.env.GOOGLE_MAPS_API_KEY} />
</main>
