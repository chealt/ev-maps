# Google Maps JavaScript API key (required).
# Enable "Maps JavaScript API" for this key and
# restrict it to your site's HTTP referrers - it is embedded in the page.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Open Charge Map API key (required for EV charger data).
# Register at https://openchargemap.org/site/develop/api. It is embedded in the page.
VITE_OPEN_CHARGE_MAP_API_KEY=

# Map ID used for advanced markers (optional, defaults to Google's DEMO_MAP_ID)
VITE_GOOGLE_MAPS_MAP_ID=

# Google OAuth client ID (optional - shows a "Sign in with Google" button)
VITE_GOOGLE_CLIENT_ID=
