{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxlint/main/schemas/oxlint.config.schema.json",
  "rules": {
    "all": "error",
    "correctness": "error",
    "suspicious": "error",
    "style": "warn",
    "pedantic": "warn",
    "nursery": "off",
    "no-unused-vars": "error",
    "no-console": "warn"
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "customElements": "readonly",
    "HTMLElement": "readonly",
    "ShadowRoot": "readonly"
  }
}
