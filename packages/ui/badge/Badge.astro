---
// A short label in a pill, e.g. a status, or a count (the accent tone). Its
// `tone` colors it; a script can change it later through the data-tone
// attribute. A script that makes badges itself gives them the class "badge"
// and imports "@ev-maps/ui/Badge.css".
import type { HTMLAttributes } from "astro/types";
import "./Badge.css";

interface Props extends HTMLAttributes<"span"> {
  tone?: "neutral" | "accent" | "success" | "warning" | "danger";
  // "md" for a badge read on its own, e.g. with an icon.
  size?: "sm" | "md";
}

const { tone = "neutral", size = "sm", class: className, ...attrs } = Astro.props;
---

<span class:list={["badge", className]} data-tone={tone} data-size={size} {...attrs}>
  <slot />
</span>
