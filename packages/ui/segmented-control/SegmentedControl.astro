---
// One choice of a few, as a row of segments: radio buttons (so keyboards and
// screen readers know it as one), shown as a segmented toggle. Listen for
// "change" on it, and read the checked input's value.
import type { HTMLAttributes } from "astro/types";
import Icon from "../icon/Icon.astro";
import "./SegmentedControl.css";

interface Option {
  value: string;
  label: string;
  /** An icon before the label (an SVG string, e.g. from lucide-static). */
  icon?: string;
  /** Attributes for the label's span, e.g. for a script that rewrites it. */
  labelAttrs?: Record<string, string>;
}

interface Props extends HTMLAttributes<"fieldset"> {
  /** The group's name, shown before the segments. */
  legend: string;
  /** The radios' name. */
  name: string;
  options: Option[];
  /** The value checked at first; the first option's by default. */
  value?: string;
  /** The legend only for screen readers, when a heading nearby says it. */
  legendHidden?: boolean;
}

const {
  legend,
  name,
  options,
  value = options[0]?.value,
  legendHidden = false,
  class: className,
  ...attrs
} = Astro.props;
---

<fieldset class:list={["segmented-control", className]} {...attrs}>
  <legend class:list={["segmented-legend", legendHidden && "hidden"]}>{legend}</legend>
  <span class="segments">
    {options.map((option) => (
      <label class="segment">
        <input
          type="radio"
          class="segment-input"
          name={name}
          value={option.value}
          checked={option.value === value}
        />
        {option.icon && <Icon icon={option.icon} size="sm" />}
        <span {...option.labelAttrs} class:list={["segment-label", option.labelAttrs?.class]}>
          {option.label}
        </span>
      </label>
    ))}
  </span>
</fieldset>
