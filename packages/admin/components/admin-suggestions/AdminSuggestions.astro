---
import Badge from "@ev-maps/ui/Badge.astro";
import Button from "@ev-maps/ui/Button.astro";
import Card from "@ev-maps/ui/Card.astro";
import SegmentedControl from "@ev-maps/ui/SegmentedControl.astro";
import ChargerProof from "../charger-proof/ChargerProof.astro";
import "./AdminSuggestions.css";

interface Props {
  // The page's strings (the host's translations for this section).
  page: Record<string, string>;
}

const { page } = Astro.props;
---

<!-- Charger suggestions submitted by signed-in users
     (GET /api/admin/charger-suggestions): admins review the location,
     chargers, proof photos and, when given, the availability and price with
     their trust score, and approve (adding to the database) or
     reject each suggestion. -->
<ev-admin-suggestions>
  <section aria-labelledby="admin-suggestions-title">
    <h2 class="section-title" id="admin-suggestions-title">
      {page.adminSuggestions}
    </h2>
    <SegmentedControl
      class="status-filter"
      legend={page.adminSuggestionStatusFilter}
      name="status"
      value="pending"
      options={[
        { value: "pending", label: page.adminSuggestionsPending },
        { value: "", label: page.adminSuggestionsAll },
        { value: "approved", label: page.adminSuggestionsApproved },
        { value: "rejected", label: page.adminSuggestionsRejected },
      ]}
    />
    <p class="summary" role="status"></p>
    <div class="suggestion-list"></div>
  </section>

  <template class="suggestion-template">
    <Card as="article" class="suggestion-card">
      <div class="card-header">
        <div>
          <h3 class="charger-name"></h3>
          <p class="charger-meta"></p>
        </div>
        <Badge class="status-badge" />
      </div>
      <div class="card-body">
        <div class="details">
          <p class="coordinates"></p>
          <p class="submitted-by"></p>
          <ul class="connectors"></ul>
          <ChargerProof page={page} />
          <div class="actions">
            <Button variant="primary" size="small" class="approve">
              {page.adminApproveSuggestion}
            </Button>
            <Button variant="danger" size="small" class="reject">
              {page.adminRejectSuggestion}
            </Button>
          </div>
        </div>
        <div class="proof">
          <ul class="proof-photos"></ul>
        </div>
      </div>
    </Card>
  </template>
  <template class="connector-item-template">
    <li class="connector-item"></li>
  </template>
  <template class="photo-item-template">
    <li>
      <img class="proof-photo" alt={page.adminProofPhoto} />
    </li>
  </template>
  <template class="receipt-item-template">
    <li>
      <img class="proof-photo" alt={page.adminReceiptPhoto} />
    </li>
  </template>
  <script src="./AdminSuggestions.js"></script>
</ev-admin-suggestions>
