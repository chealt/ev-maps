---
import Badge from "@ev-maps/ui/Badge.astro";
import Button from "@ev-maps/ui/Button.astro";
import Card from "@ev-maps/ui/Card.astro";
import SegmentedControl from "@ev-maps/ui/SegmentedControl.astro";
import { formatMessage } from "@ev-maps/ui/format.js";
import ChargerProof from "../charger-proof/ChargerProof.astro";
import "./AdminChargerReports.css";

// Rendered on the server: the reports with ?status= (pending by default, or
// approved, rejected, all), from the Worker
// (packages/worker/src/charger-reports.js).
interface Props {
  // { data } or { failed: true } (the host's page data)
  pageData: { data?: any; failed?: boolean };
  // The page's strings, runtime message templates and value labels (the
  // host's translations).
  page: Record<string, any>;
  messages: Record<string, any>;
  values: Record<string, any>;
}

const { page, messages, values } = Astro.props;
const lang = Astro.currentLocale ?? "en";
const { data, failed } = Astro.props.pageData;
const reports: any[] = data?.reports ?? [];
const status = Astro.url.searchParams.get("status") ?? "pending";

const STATUS_MESSAGES: Record<string, string> = {
  pending: "adminSuggestionPending",
  approved: "adminSuggestionApproved",
  rejected: "adminSuggestionRejected",
};
// A report's status as its badge's tone.
const STATUS_TONES: Record<string, string> = {
  pending: "warning",
  approved: "success",
  rejected: "danger",
};
// A photo's alt text by what it shows.
const PHOTO_MESSAGES: Record<string, string> = {
  charger: "adminChargerPhoto",
  receipt: "adminReceiptPhoto",
};

const formatTime = (timestamp: number) =>
  new Intl.DateTimeFormat(lang, { dateStyle: "medium", timeStyle: "short" }).format(
    new Date(timestamp)
  );

const summary = failed
  ? messages.adminReportsNotLoaded
  : reports.length === 0
    ? messages.adminNoChargerReports
    : formatMessage(lang, messages.adminChargerReportCount, { count: reports.length });
---

<!-- Changes to chargers' availability and price reported by signed-in users:
     admins weigh the proof and the trust score, and approve (the charger
     shows the change) or reject each. The status filter and the buttons
     need the script. -->
<ev-admin-charger-reports>
  <section aria-labelledby="admin-charger-reports-title">
    <h2 class="section-title" id="admin-charger-reports-title">
      {page.adminChargerReports}
    </h2>
    <SegmentedControl
      class="status-filter"
      legend={page.adminSuggestionStatusFilter}
      name="status"
      value={status}
      options={[
        { value: "pending", label: page.adminSuggestionsPending },
        { value: "all", label: page.adminSuggestionsAll },
        { value: "approved", label: page.adminSuggestionsApproved },
        { value: "rejected", label: page.adminSuggestionsRejected },
      ]}
    />
    <p class="summary" role="status">
      {summary}
    </p>
    <div class="report-list">
      {reports.map((report) => (
        <Card as="article" class="report-card" data-review-id={report.id}>
          <div class="card-header">
            <div>
              <h3 class="charger-name">{report.chargerName || report.chargerId}</h3>
              <p class="reported-by">
                {formatMessage(lang, messages.adminReportedBy, {
                  email: report.userEmail ?? "?",
                  date: formatTime(report.createdAt),
                })}
              </p>
            </div>
            <Badge class="status-badge" data-tone={STATUS_TONES[report.status] ?? "warning"}>
              {messages[STATUS_MESSAGES[report.status] ?? "adminSuggestionPending"]}
            </Badge>
          </div>
          <div class="card-body">
            <div class="details">
              <ChargerProof page={page} item={report} messages={messages} values={values} />
              {report.status === "pending" && (
                <div class="actions">
                  <Button variant="primary" size="small" class="review" data-action="approve">
                    {page.adminApproveReport}
                  </Button>
                  <Button variant="danger" size="small" class="review" data-action="reject">
                    {page.adminRejectSuggestion}
                  </Button>
                </div>
              )}
            </div>
            <ul class="proof-photos">
              {report.photos.map(({ kind, url }: any) => (
                <li>
                  <img
                    class="proof-photo"
                    src={url}
                    alt={messages[PHOTO_MESSAGES[kind] ?? "adminChargerPhoto"]}
                  />
                </li>
              ))}
            </ul>
          </div>
        </Card>
      ))}
    </div>
  </section>
  <script src="./AdminChargerReports.js"></script>
</ev-admin-charger-reports>
