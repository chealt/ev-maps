---
import { ArrowLeft, ChevronDown } from "lucide-static";
import Button from "@ev-maps/ui/Button.astro";
import Icon from "@ev-maps/ui/Icon.astro";
import { formatMessage } from "@ev-maps/ui/format.js";
import "./AdminErrors.css";

// Rendered on the server: the error groups, or with ?error={fingerprint} one
// group's occurrences, from the Worker (packages/admin/src/admin.js).
interface Props {
  // { data } or { failed: true } (the host's page data)
  pageData: { data?: any; failed?: boolean };
  // The page's strings (the host's translations for this section).
  page: Record<string, any>;
  // The runtime message templates (for the pager's "page X of Y").
  messages: Record<string, any>;
}

const { page, messages } = Astro.props;
const lang = Astro.currentLocale ?? "en";
const { data, failed } = Astro.props.pageData;
const now = Date.now();

const formatTime = (timestamp: number) =>
  new Intl.DateTimeFormat(lang, { dateStyle: "medium", timeStyle: "medium" }).format(
    new Date(timestamp)
  );

// "5 minutes ago", "yesterday"…
const timeAgo = (timestamp: number) => {
  const seconds = Math.round((timestamp - now) / 1000);
  const format = new Intl.RelativeTimeFormat(lang, { numeric: "auto" });
  const units: [Intl.RelativeTimeFormatUnit, number][] = [
    ["day", 86400],
    ["hour", 3600],
    ["minute", 60],
  ];
  const [unit, size] = units.find(([, unitSize]) => Math.abs(seconds) >= unitSize) ?? ["second", 1];
  return format.format(Math.round(seconds / size), unit);
};

const title = (error: { name?: string; message: string }) =>
  `${error.name ? `${error.name}: ` : ""}${error.message}`;

// The active filters and order, so every view of this page keeps them.
const filters: Record<string, any> = data?.filters ?? {};
const filterParams = () => {
  const params = new URLSearchParams();
  if (filters.sort && filters.sort !== "last_seen") {
    params.set("sort", filters.sort);
  }
  for (const key of ["source", "country", "browser", "os", "q"]) {
    if (filters[key]) {
      params.set(key, filters[key]);
    }
  }
  return params;
};
const filtering = [...filterParams()].length > 0;

// A link to a view of this page: the filters and order, ?error=, and ?page=
// after the first.
const viewUrl = ({ error, page: number }: { error?: string; page: number }) => {
  const params = filterParams();
  if (error) {
    params.set("error", error);
  }
  if (number > 1) {
    params.set("page", String(number));
  }
  const query = params.toString();
  return query ? `?${query}` : Astro.url.pathname;
};

const facets = data?.facets ?? { sources: [], countries: [], browsers: [], oss: [] };

// The sortable columns' links: the chosen one shows its order, another
// starts at the first page ordered by it.
const sort = data?.sort ?? "last_seen";
const sortUrl = (key: string) => {
  const params = filterParams();
  if (key !== "last_seen") {
    params.set("sort", key);
  }
  const query = params.toString();
  return query ? `?${query}` : Astro.url.pathname;
};

const isGroup = Boolean(data?.fingerprint);
const none = page.adminNone;
const summary = failed
  ? page.adminErrorsNotLoaded
  : isGroup
    ? formatMessage(lang, page.adminOccurrences, { count: data.total })
    : data.total === 0
      ? page.adminNoErrors
      : formatMessage(lang, page.adminErrorGroups, { count: data.total });
const occurrenceFacts = (occurrence: any) => [
  [page.adminTimeLabel, formatTime(occurrence.created_at)],
  [page.adminUrlLabel, [occurrence.method, occurrence.url].filter(Boolean).join(" ")],
  [page.adminContextLabel, occurrence.context],
  [page.adminBrowserLabel, occurrence.user_agent],
  [page.adminUserLabel, occurrence.user_id],
  [page.adminCountryLabel, occurrence.country],
];
---

<div class="admin-errors">
  {isGroup ? (
    <section class="group-view" aria-labelledby="admin-error-title">
      <a class="all-errors" href={Astro.url.pathname}>
        <Icon icon={ArrowLeft} size="sm" />
        {page.adminAllErrors}
      </a>
      <h2 class="section-title" id="admin-error-title">
        {data.occurrences[0] ? title(data.occurrences[0]) : page.adminNoErrors}
      </h2>
      <p class="summary">{summary}</p>
      <ol class="occurrences">
        {data.occurrences.map((occurrence: any) => (
          <li class="occurrence">
            <dl class="facts">
              {occurrenceFacts(occurrence).map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value || none}</dd>
                </div>
              ))}
            </dl>
            <details class="stack-details">
              <summary>{page.adminStackTrace}</summary>
              <pre class="stack">{occurrence.stack || none}</pre>
            </details>
          </li>
        ))}
      </ol>
    </section>
  ) : (
    <section class="groups-view" aria-labelledby="admin-errors-title">
      <h2 class="section-title" id="admin-errors-title">
        {page.adminErrors}
      </h2>
      {data && (
        <form class="filters" method="get" aria-label={page.adminErrorFilters}>
          <label class="filter">
            <span class="filter-label">{page.adminSourceColumn}</span>
            <span class="select-wrap">
              <select name="source">
                <option value="">{page.adminFilterAll}</option>
                {facets.sources.map((source: string) => (
                  <option value={source} selected={filters.source === source}>
                    {page.adminErrorSources[source] ?? source}
                  </option>
                ))}
              </select>
              <Icon icon={ChevronDown} size="sm" class="chevron" />
            </span>
          </label>
          <label class="filter">
            <span class="filter-label">{page.adminBrowserColumn}</span>
            <span class="select-wrap">
              <select name="browser">
                <option value="">{page.adminFilterAll}</option>
                {facets.browsers.map((browser: string) => (
                  <option value={browser} selected={filters.browser === browser}>
                    {browser}
                  </option>
                ))}
              </select>
              <Icon icon={ChevronDown} size="sm" class="chevron" />
            </span>
          </label>
          <label class="filter">
            <span class="filter-label">{page.adminOsColumn}</span>
            <span class="select-wrap">
              <select name="os">
                <option value="">{page.adminFilterAll}</option>
                {facets.oss.map((os: string) => (
                  <option value={os} selected={filters.os === os}>
                    {os}
                  </option>
                ))}
              </select>
              <Icon icon={ChevronDown} size="sm" class="chevron" />
            </span>
          </label>
          <label class="filter">
            <span class="filter-label">{page.adminCountryLabel}</span>
            <span class="select-wrap">
              <select name="country">
                <option value="">{page.adminFilterAll}</option>
                {facets.countries.map((country: string) => (
                  <option value={country} selected={filters.country === country}>
                    {country}
                  </option>
                ))}
              </select>
              <Icon icon={ChevronDown} size="sm" class="chevron" />
            </span>
          </label>
          <label class="filter search">
            <span class="filter-label">{page.adminFilterSearch}</span>
            <input type="search" name="q" value={filters.q ?? ""} />
          </label>
          {/* Applying the filters keeps the order chosen in the headers. */}
          {sort !== "last_seen" && <input type="hidden" name="sort" value={sort} />}
          <Button variant="secondary" size="small" type="submit" class="apply">
            {page.adminFilterApply}
          </Button>
          {filtering && (
            <a class="clear" href={Astro.url.pathname}>
              {page.adminFilterClear}
            </a>
          )}
        </form>
      )}
      <p class={failed ? "summary failed" : "summary"} role={failed ? "alert" : undefined}>
        {summary}
      </p>
      {data?.groups.length > 0 && (
        <div class="table-wrapper">
          <table class="groups">
            <thead>
              <tr>
                <th scope="col">{page.adminErrorColumn}</th>
                <th scope="col">{page.adminSourceColumn}</th>
                <th scope="col">{page.adminBrowserColumn}</th>
                <th scope="col">{page.adminOsColumn}</th>
                <th scope="col">{page.adminCountryLabel}</th>
                <th scope="col" class="number" aria-sort={sort === "count" ? "descending" : "none"}>
                  <a class="sort" href={sortUrl("count")}>
                    {page.adminCountColumn}
                    {sort === "count" && <Icon icon={ChevronDown} size="sm" class="sort-arrow" />}
                  </a>
                </th>
                <th scope="col" class="number">
                  {page.adminUsersColumn}
                </th>
                <th scope="col" aria-sort={sort === "last_seen" ? "descending" : "none"}>
                  <a class="sort" href={sortUrl("last_seen")}>
                    {page.adminLastSeenColumn}
                    {sort === "last_seen" && (
                      <Icon icon={ChevronDown} size="sm" class="sort-arrow" />
                    )}
                  </a>
                </th>
                <th scope="col" aria-sort={sort === "first_seen" ? "descending" : "none"}>
                  <a class="sort" href={sortUrl("first_seen")}>
                    {page.adminFirstSeenColumn}
                    {sort === "first_seen" && (
                      <Icon icon={ChevronDown} size="sm" class="sort-arrow" />
                    )}
                  </a>
                </th>
              </tr>
            </thead>
            <tbody>
              {data.groups.map((group: any) => (
                <tr>
                  <td>
                    <a class="message" href={viewUrl({ error: group.fingerprint, page: 1 })}>
                      {title(group)}
                    </a>
                    <span class="where">{group.context ?? group.url ?? ""}</span>
                  </td>
                  <td class="source">{page.adminErrorSources[group.source] ?? group.source}</td>
                  <td class="browser">{group.browser ?? none}</td>
                  <td class="os">{group.os ?? none}</td>
                  <td class="country">{group.country ?? none}</td>
                  <td class="count number">{group.count}</td>
                  <td class="users number">{group.users}</td>
                  <td class="last-seen" title={formatTime(group.last_seen)}>
                    {timeAgo(group.last_seen)}
                  </td>
                  <td class="first-seen" title={formatTime(group.first_seen)}>
                    {timeAgo(group.first_seen)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  )}
  {data?.pages > 1 && (
    <nav class="pager" aria-label={page.adminPages}>
      {data.page > 1 ? (
        <a class="previous" href={viewUrl({ error: data.fingerprint, page: data.page - 1 })}>
          {page.adminPreviousPage}
        </a>
      ) : (
        <span class="previous" aria-disabled="true">
          {page.adminPreviousPage}
        </span>
      )}
      <span class="page-of">
        {formatMessage(lang, messages.adminPageOf, { page: data.page, pages: data.pages })}
      </span>
      {data.page < data.pages ? (
        <a class="next" href={viewUrl({ error: data.fingerprint, page: data.page + 1 })}>
          {page.adminNextPage}
        </a>
      ) : (
        <span class="next" aria-disabled="true">
          {page.adminNextPage}
        </span>
      )}
    </nav>
  )}
</div>
