---
import { ArrowLeft } from "lucide-static";
import Icon from "@ev-maps/ui/Icon.astro";
import { formatMessage, translations } from "#i18n/index.js";
import "./AdminErrors.css";

// Rendered on the server: the error groups, or with ?error={fingerprint} one
// group's occurrences, from the Worker (packages/admin/src/admin.js).
interface Props {
  // { data } or { failed: true } (src/lib/page-data.js)
  pageData: { data?: any; failed?: boolean };
}

const lang = Astro.currentLocale ?? "en";
const { page, messages } = translations(lang);
const { data, failed } = Astro.props.pageData;
const now = Date.now();

const formatTime = (timestamp: number) =>
  new Intl.DateTimeFormat(lang, { dateStyle: "medium", timeStyle: "medium" }).format(
    new Date(timestamp)
  );

// "5 minutes ago", "yesterday"…
const timeAgo = (timestamp: number) => {
  const seconds = Math.round((timestamp - now) / 1000);
  const format = new Intl.RelativeTimeFormat(lang, { numeric: "auto" });
  const units: [Intl.RelativeTimeFormatUnit, number][] = [
    ["day", 86400],
    ["hour", 3600],
    ["minute", 60],
  ];
  const [unit, size] = units.find(([, unitSize]) => Math.abs(seconds) >= unitSize) ?? ["second", 1];
  return format.format(Math.round(seconds / size), unit);
};

const title = (error: { name?: string; message: string }) =>
  `${error.name ? `${error.name}: ` : ""}${error.message}`;

// A link to a view of this page: ?error=, and ?page= after the first.
const viewUrl = ({ error, page: number }: { error?: string; page: number }) => {
  const params = new URLSearchParams();
  if (error) {
    params.set("error", error);
  }
  if (number > 1) {
    params.set("page", String(number));
  }
  const query = params.toString();
  return query ? `?${query}` : Astro.url.pathname;
};

const isGroup = Boolean(data?.fingerprint);
const none = page.adminNone;
const summary = failed
  ? page.adminErrorsNotLoaded
  : isGroup
    ? formatMessage(lang, page.adminOccurrences, { count: data.total })
    : data.total === 0
      ? page.adminNoErrors
      : formatMessage(lang, page.adminErrorGroups, { count: data.total });
const occurrenceFacts = (occurrence: any) => [
  [page.adminTimeLabel, formatTime(occurrence.created_at)],
  [page.adminUrlLabel, [occurrence.method, occurrence.url].filter(Boolean).join(" ")],
  [page.adminContextLabel, occurrence.context],
  [page.adminBrowserLabel, occurrence.user_agent],
  [page.adminUserLabel, occurrence.user_id],
  [page.adminCountryLabel, occurrence.country],
];
---

<div class="admin-errors">
  {isGroup ? (
    <section class="group-view" aria-labelledby="admin-error-title">
      <a class="all-errors" href={Astro.url.pathname}>
        <Icon icon={ArrowLeft} size="sm" />
        {page.adminAllErrors}
      </a>
      <h2 class="section-title" id="admin-error-title">
        {data.occurrences[0] ? title(data.occurrences[0]) : page.adminNoErrors}
      </h2>
      <p class="summary">{summary}</p>
      <ol class="occurrences">
        {data.occurrences.map((occurrence: any) => (
          <li class="occurrence">
            <dl class="facts">
              {occurrenceFacts(occurrence).map(([label, value]) => (
                <div>
                  <dt>{label}</dt>
                  <dd>{value || none}</dd>
                </div>
              ))}
            </dl>
            <details class="stack-details">
              <summary>{page.adminStackTrace}</summary>
              <pre class="stack">{occurrence.stack || none}</pre>
            </details>
          </li>
        ))}
      </ol>
    </section>
  ) : (
    <section class="groups-view" aria-labelledby="admin-errors-title">
      <h2 class="section-title" id="admin-errors-title">
        {page.adminErrors}
      </h2>
      <p class={failed ? "summary failed" : "summary"} role={failed ? "alert" : undefined}>
        {summary}
      </p>
      {data?.groups.length > 0 && (
        <div class="table-wrapper">
          <table class="groups">
            <thead>
              <tr>
                <th scope="col">{page.adminErrorColumn}</th>
                <th scope="col">{page.adminSourceColumn}</th>
                <th scope="col" class="number">
                  {page.adminCountColumn}
                </th>
                <th scope="col" class="number">
                  {page.adminUsersColumn}
                </th>
                <th scope="col">{page.adminLastSeenColumn}</th>
                <th scope="col">{page.adminFirstSeenColumn}</th>
              </tr>
            </thead>
            <tbody>
              {data.groups.map((group: any) => (
                <tr>
                  <td>
                    <a class="message" href={viewUrl({ error: group.fingerprint, page: 1 })}>
                      {title(group)}
                    </a>
                    <span class="where">{group.context ?? group.url ?? ""}</span>
                  </td>
                  <td class="source">{page.adminErrorSources[group.source] ?? group.source}</td>
                  <td class="count number">{group.count}</td>
                  <td class="users number">{group.users}</td>
                  <td class="last-seen" title={formatTime(group.last_seen)}>
                    {timeAgo(group.last_seen)}
                  </td>
                  <td class="first-seen" title={formatTime(group.first_seen)}>
                    {timeAgo(group.first_seen)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  )}
  {data?.pages > 1 && (
    <nav class="pager" aria-label={page.adminPages}>
      {data.page > 1 ? (
        <a class="previous" href={viewUrl({ error: data.fingerprint, page: data.page - 1 })}>
          {page.adminPreviousPage}
        </a>
      ) : (
        <span class="previous" aria-disabled="true">
          {page.adminPreviousPage}
        </span>
      )}
      <span class="page-of">
        {formatMessage(lang, messages.adminPageOf, { page: data.page, pages: data.pages })}
      </span>
      {data.page < data.pages ? (
        <a class="next" href={viewUrl({ error: data.fingerprint, page: data.page + 1 })}>
          {page.adminNextPage}
        </a>
      ) : (
        <span class="next" aria-disabled="true">
          {page.adminNextPage}
        </span>
      )}
    </nav>
  )}
</div>
