---
import Badge from "@ev-maps/ui/Badge.astro";
import { formatMessage } from "@ev-maps/ui/format.js";
import "./ChargerProof.css";

interface Props {
  // The page's strings (the host's translations for this section).
  page: Record<string, any>;
  // The report or suggestion it's about.
  item: Record<string, any>;
  // The runtime message templates and value labels (the host's
  // translations).
  messages: Record<string, any>;
  values: Record<string, any>;
}

const { page, item, messages, values } = Astro.props;
const lang = Astro.currentLocale ?? "en";

const trustTone = (score: number) => (score >= 70 ? "success" : score >= 40 ? "warning" : "danger");
const PRICE_MESSAGES: Record<string, string> = {
  kwh: "adminPricePerKwh",
  minute: "adminPricePerMinute",
  session: "adminPricePerSession",
};
const text = (key: string, args = {}) => formatMessage(lang, messages[key], args);
const label = (table: string, value: string) => values[table]?.[value] ?? value;
const priceText = (price: any) =>
  price.free
    ? text("adminPriceFree")
    : text(PRICE_MESSAGES[price.unit], {
        amount: new Intl.NumberFormat(lang, {
          style: "currency",
          currency: price.currency,
          maximumFractionDigits: 4,
        }).format(price.amount),
      });
const changeText = (before: string | undefined, after: string) =>
  before ? text("adminChange", { before, after }) : after;

const hasTrust = Number.isFinite(item.trustScore);
const hasChange = Boolean(item.availability || item.price);
const factors = item ? (item.trustFactors ?? []).filter(({ points }: any) => points !== 0) : [];
const deviceText = !item
  ? ""
  : !Number.isFinite(item.distanceM)
    ? text("adminNoDeviceLocation")
    : Number.isFinite(item.deviceLocation?.accuracy)
      ? text("adminDeviceDistanceAccuracy", {
          distance: item.distanceM,
          accuracy: Math.round(item.deviceLocation.accuracy),
        })
      : text("adminDeviceDistance", { distance: item.distanceM });
---

<!-- What a user said about a charger's availability and price, and how far
     to trust it: the score with its factors, and where their device was.
     Rendered on the server; hidden when there's nothing to show. -->
<div class="charger-proof" hidden={!hasTrust && !hasChange}>
  <p class="trust" hidden={!hasTrust}>
    <span class="trust-label">{page.adminTrust}</span>
    <Badge class="trust-score" tone={hasTrust ? trustTone(item.trustScore) : "neutral"}>
      {hasTrust && text("adminTrustScore", { score: item.trustScore })}
    </Badge>
    <span
      class="trust-bar"
      aria-hidden="true"
      data-tone={hasTrust ? trustTone(item.trustScore) : "neutral"}
      style={`--score: ${hasTrust ? item.trustScore / 100 : 0}`}
    ></span>
  </p>
  <ul class="trust-factors" aria-label={page.adminTrustFactors}>
    {factors.map(({ id, points }: any) => (
      <li>
        {text("adminTrustFactor", {
          factor: label("trustFactors", id),
          points: points > 0 ? `+${points}` : `${points}`,
        })}
      </li>
    ))}
  </ul>
  <dl class="changes">
    <div class="change availability-change" hidden={!item.availability}>
      <dt>{page.adminReportedAvailability}</dt>
      <dd class="availability">
        {item.availability &&
          changeText(
            item.currentStatus && label("status", item.currentStatus),
            label("status", item.availability)
          )}
      </dd>
    </div>
    <div class="change price-change" hidden={!item.price}>
      <dt>{page.adminReportedPrice}</dt>
      <dd class="price">{item.price && changeText(item.currentCost, priceText(item.price))}</dd>
    </div>
  </dl>
  <p class="device-location" hidden={!hasTrust}>
    {deviceText}
  </p>
</div>
